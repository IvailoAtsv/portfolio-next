---
interface Props {
  id: string;
  words: string[];
  separator?: string;
  repeats?: number;
  radius: number;
  size?: number;
  class?: string;
}

const {
  id,
  words,
  separator = '·',
  repeats = 1,
  radius,
  size = 400,
  class: className,
} = Astro.props;

const cx = size / 2;
const cy = size / 2;
const sequence = Array.from({ length: repeats }, () => words).flat();
const wordCount = sequence.length;
const showSeps = Boolean(separator) && wordCount > 0;
const sepRadius = Math.max(1.7, size * 0.017);
const sepPositions = sequence.map((_, index) => {
  const angle = ((index + 1) / wordCount) * Math.PI * 2 - Math.PI / 2;
  return {
    x: +(cx + radius * Math.cos(angle)).toFixed(2),
    y: +(cy + radius * Math.sin(angle)).toFixed(2),
  };
});
---

<svg
  class:list={['circle-words', className]}
  viewBox={`0 0 ${size} ${size}`}
  aria-hidden="true"
  data-circle-words
>
  <slot name="back" />
  <path
    id={id}
    data-circle-path
    d={`M ${cx} ${cy - radius} a ${radius} ${radius} 0 1 1 0 ${radius * 2} a ${radius} ${radius} 0 1 1 0 ${-radius * 2}`}
    fill="none"></path>
  {
    sequence.map((word, index) => (
      <text>
        <textPath
          href={`#${id}`}
          data-circle-word
          startOffset={`${((index + 0.5) / wordCount) * 100}%`}
          text-anchor="middle"
        >
          {word}
        </textPath>
      </text>
    ))
  }
  {
    showSeps &&
      sepPositions.map((point) => (
        <circle data-circle-sep cx={point.x} cy={point.y} r={sepRadius} />
      ))
  }
  <slot />
</svg>

<script>
  const placeOnPath = (
    token: SVGTextPathElement,
    center: number,
    pathLength: number,
  ) => {
    const width = token.getComputedTextLength();
    let start = ((center - width / 2) % pathLength) + pathLength;
    start %= pathLength;
    if (start + width > pathLength) {
      start = Math.max(0, pathLength - width - 0.5);
    }
    token.setAttribute('text-anchor', 'start');
    token.setAttribute('startOffset', String(start));
  };

  const layoutRing = (svg: SVGSVGElement) => {
    const path = svg.querySelector<SVGPathElement>('[data-circle-path]');
    const words = [
      ...svg.querySelectorAll<SVGTextPathElement>('[data-circle-word]'),
    ];
    const separators = [
      ...svg.querySelectorAll<SVGCircleElement>('[data-circle-sep]'),
    ];
    if (!path || words.length === 0) return;

    const pathLength = path.getTotalLength();
    if (!pathLength) return;

    const wordWidths = words.map((word) => word.getComputedTextLength());
    if (wordWidths.some((width) => width <= 0)) return;

    const totalWordWidth = wordWidths.reduce((sum, width) => sum + width, 0);
    const gap = (pathLength - totalWordWidth) / words.length;
    if (gap <= 0) return;

    const fontSize = parseFloat(getComputedStyle(words[0]).fontSize) || 16;
    const sepRadius = Math.max(1.6, fontSize * 0.12);

    let cursor = gap / 2;
    words.forEach((word, index) => {
      placeOnPath(word, cursor + wordWidths[index] / 2, pathLength);
      cursor += wordWidths[index];
      const sep = separators[index];
      if (sep) {
        const at = (cursor + gap / 2) % pathLength;
        const point = path.getPointAtLength(at);
        sep.setAttribute('cx', String(point.x));
        sep.setAttribute('cy', String(point.y));
        sep.setAttribute('r', String(sepRadius));
      }
      cursor += gap;
    });
  };

  const layoutAllRings = () => {
    document
      .querySelectorAll<SVGSVGElement>('[data-circle-words]')
      .forEach(layoutRing);
  };

  layoutAllRings();
  void document.fonts.ready.then(layoutAllRings);
  document.addEventListener('astro:page-load', layoutAllRings);
</script>
