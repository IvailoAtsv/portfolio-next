---
interface Props {
  home?: boolean;
}

const { home = false } = Astro.props;
const workHref = home ? '#work' : '/#work';
const practiceHref = home ? '#practice' : '/#practice';
const aboutHref = home ? '#about' : '/#about';
const contactHref = home ? '#contact' : '/#contact';
---

<header class="site-header">
  <a
    class="studio-mark"
    href="/"
    aria-label="Ivaylo Atanassov, home"
    data-squash
  >
    <svg viewBox="0 0 58 58" aria-hidden="true">
      <path
        class="mark-disc"
        d="M29 3C44 3 55 14 55 29S44 55 29 55 3 44 3 29 14 3 29 3Z"></path>
      <path
        class="mark-eye"
        d="M18 21c3-4 7-2 7 3 0 4-2 7-5 7s-5-6-2-10Zm17-1c4-3 7 0 6 5 0 4-3 7-6 6-3-2-3-8 0-11Z"
      ></path>
      <path class="mark-smile" d="M17 36c7 8 18 9 26-1"></path>
    </svg>
    <span>
      <strong>IVAYLO</strong>
      <small>DOES IT ALL</small>
    </span>
  </a>

  <nav class="desktop-nav" aria-label="Primary navigation">
    <a href={workHref}>Work</a>
    <a href={practiceHref}>How I work</a>
    <a href={aboutHref}>About</a>
    <a class="nav-contact" href={contactHref}>Let's talk</a>
  </nav>

  <div class="mobile-nav">
    <button
      class="mobile-menu-button"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span>Menu</span>
      <svg viewBox="0 0 24 24" aria-hidden="true"
        ><path d="M4 8h16M4 16h16"></path></svg
      >
    </button>
    <nav id="mobile-menu" aria-label="Mobile navigation" hidden>
      <a href={workHref}>Work</a>
      <a href={practiceHref}>How I work</a>
      <a href={aboutHref}>About</a>
      <a href={contactHref}>Let's talk</a>
    </nav>
  </div>
</header>
