---
interface Props {
  src: string;
  poster: string;
  label: string;
  width: number;
  height: number;
  preview?: boolean;
}
const { src, poster, label, width, height, preview = true } = Astro.props;
---

<project-player data-preview={preview}>
  <video
    muted
    loop
    playsinline
    preload="none"
    poster={poster}
    width={width}
    height={height}
    aria-label={label}
  >
    <source src={src} type="video/mp4" />
    <a href={src}>Watch {label}</a>
  </video>
  <button type="button" class="preview-toggle" aria-label="Play recording"
  ></button>
  <p class="video-error" role="status" hidden>
    Video could not load. <a href={src}>Open the recording</a>.
  </p>
</project-player>

<style>
  project-player {
    position: relative;
    display: block;
    min-width: 0;
  }
  video {
    display: block;
    width: 100%;
    height: auto;
    background: #11110f;
    border-radius: inherit;
  }
  video::-webkit-media-controls,
  video::-webkit-media-controls-enclosure,
  video::-webkit-media-controls-panel,
  video::-webkit-media-controls-start-playback-button,
  video::-webkit-media-controls-overlay-play-button {
    display: none !important;
    appearance: none;
    opacity: 0;
    pointer-events: none;
  }
  .preview-toggle {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    border-radius: inherit;
    background: transparent;
    cursor: pointer;
  }
  .preview-toggle:focus {
    outline: none;
  }
  .preview-toggle:focus-visible {
    outline: 3px solid #fff;
    outline-offset: -3px;
    box-shadow: inset 0 0 0 6px #11110f;
  }
  .video-error {
    padding: 0.75rem;
    color: var(--paper-light);
    background: var(--ink);
  }
  .video-error[hidden] {
    display: none;
  }
  .video-error a {
    text-decoration: underline;
  }
</style>

<script>
  class ProjectPlayer extends HTMLElement {
    private stop?: () => void;
    connectedCallback() {
      this.stop?.();
      const video = this.querySelector('video');
      const toggle = this.querySelector<HTMLButtonElement>('.preview-toggle');
      if (!video) return;
      const safari = video as HTMLVideoElement & {
        webkitDisplayingFullscreen?: boolean;
        webkitExitFullscreen?: () => void;
        webkitPresentationMode?: string;
        webkitSetPresentationMode?: (mode: 'inline') => void;
      };
      video.controls = false;
      video.defaultMuted = true;
      video.muted = true;
      video.playsInline = true;
      video.disablePictureInPicture = true;
      video.disableRemotePlayback = true;
      video.setAttribute('webkit-playsinline', '');
      video.setAttribute('x-webkit-airplay', 'deny');
      video.setAttribute(
        'controlslist',
        'nofullscreen nodownload noremoteplayback noplaybackrate',
      );
      const controller = new AbortController();
      const { signal } = controller;
      const reduced = matchMedia('(prefers-reduced-motion: reduce)');
      let visible = false;
      let userPaused = false;
      let automaticPause = false;
      const labelToggle = () => {
        toggle?.setAttribute(
          'aria-label',
          video.paused ? 'Play recording' : 'Pause recording',
        );
      };
      const keepInline = () => {
        if (
          safari.webkitPresentationMode &&
          safari.webkitPresentationMode !== 'inline'
        ) {
          safari.webkitSetPresentationMode?.('inline');
        }
        if (safari.webkitDisplayingFullscreen) {
          safari.webkitExitFullscreen?.();
        }
      };
      const pause = () => {
        if (video.paused) return;
        automaticPause = true;
        video.pause();
      };
      const sync = () => {
        if (!visible || document.hidden) {
          pause();
          return;
        }
        if (
          this.dataset.preview === 'true' &&
          !reduced.matches &&
          !userPaused
        ) {
          video.muted = true;
          video.controls = false;
          void video.play().catch(() => {
            labelToggle();
          });
        }
      };
      video.addEventListener(
        'pause',
        () => {
          if (!automaticPause) userPaused = true;
          automaticPause = false;
          labelToggle();
        },
        { signal },
      );
      video.addEventListener(
        'play',
        () => {
          userPaused = false;
          video.controls = false;
          keepInline();
          labelToggle();
        },
        { signal },
      );
      toggle?.addEventListener(
        'click',
        () => {
          if (video.paused) {
            video.muted = true;
            video.controls = false;
            void video.play();
          } else {
            video.pause();
          }
        },
        { signal },
      );
      video.addEventListener(
        'webkitbeginfullscreen',
        (event) => {
          event.preventDefault();
          keepInline();
        },
        { signal },
      );
      video.addEventListener('webkitpresentationmodechanged', keepInline, {
        signal,
      });
      video.addEventListener(
        'enterpictureinpicture',
        () => {
          void document.exitPictureInPicture();
        },
        { signal },
      );
      const observer = new IntersectionObserver(
        ([entry]) => {
          visible = entry.isIntersecting;
          sync();
        },
        { threshold: 0.15 },
      );
      observer.observe(video);
      document.addEventListener('visibilitychange', sync, { signal });
      reduced.addEventListener(
        'change',
        () => {
          if (reduced.matches) pause();
          else sync();
        },
        { signal },
      );
      const showError = () => {
        this.querySelector<HTMLElement>('.video-error')!.hidden = false;
        if (toggle) toggle.hidden = true;
      };
      video.addEventListener('error', showError, { signal });
      video
        .querySelector('source')
        ?.addEventListener('error', showError, { signal });
      labelToggle();
      this.stop = () => {
        observer.disconnect();
        controller.abort();
        video.pause();
      };
    }
    disconnectedCallback() {
      this.stop?.();
    }
  }
  if (!customElements.get('project-player'))
    customElements.define('project-player', ProjectPlayer);
</script>
