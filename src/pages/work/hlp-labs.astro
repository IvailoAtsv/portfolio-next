---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StudioNav from '../../components/StudioNav.astro';
import ArrowIcon from '../../components/ArrowIcon.astro';
import FilmStatic from '../../components/FilmStatic.astro';

const systemNodes = [
  {
    id: 'catalog',
    label: 'Catalog',
    note: 'Find and compare',
    x: 500,
    y: 250,
    tone: 'red',
  },
  {
    id: 'encyclopedia',
    label: 'Encyclopedia',
    note: 'Understand terms',
    x: 175,
    y: 95,
  },
  {
    id: 'guides',
    label: 'Guides',
    note: 'Follow context',
    x: 825,
    y: 95,
    tone: 'yellow',
  },
  {
    id: 'calculator',
    label: 'Calculator',
    note: 'Work through quantities',
    x: 175,
    y: 405,
  },
  {
    id: 'assistant',
    label: 'AI assistant',
    note: 'Ask in context',
    x: 825,
    y: 405,
    tone: 'green',
  },
];
const hub = systemNodes[0];
const spokes = systemNodes.slice(1);
---

<BaseLayout
  title="HLP Labs case study — Ivaylo Atanassov"
  description="How I designed and built a connected research-commerce product spanning storefront, knowledge, AI assistance, and operations."
  image="/assets/projects/hlp/storefront-live.png"
>
  <div class="site-shell case-shell">
    <StudioNav />

    <main id="main-content">
      <article class="case-study">
        <header class="case-hero">
          <div class="case-heading">
            <a class="pill-link back-link fade-up" style="--i: 0" href="/#top">
              <ArrowIcon direction="left" /> Back to the reel
            </a>
            <h1 class="hero-title">
              <span class="title-line"
                ><span class="pop" style="--i: 0">HLP</span></span
              >
              <span class="title-line title-outline"
                ><span class="pop" style="--i: 1">Labs.</span></span
              >
            </h1>
            <p class="fade-up" style="--i: 1">
              A research-commerce system designed to make a technical catalog
              understandable and daily operations manageable.
            </p>
            <div class="case-actions fade-up" style="--i: 2">
              <a
                class="button button-dark"
                href="https://www.hlplabs.com"
                target="_blank"
                rel="noreferrer"
                data-squash
              >
                Visit the live site <ArrowIcon direction="external" />
              </a>
            </div>
          </div>

          <div class="hero-stage case-stage" data-loop>
            <div class="hero-cel cel-enter has-film">
              <img
                src="/assets/generated/hlp-lab-scene.webp"
                alt="A friendly vial character points at a microscope slide beside a glass display of organized samples"
                width="1400"
                height="1000"
                fetchpriority="high"
              />
              <FilmStatic />
            </div>
            <div class="stage-sign stage-sign-red" aria-hidden="true">
              <span>Product design</span>
              <i>×</i>
              <span>Full-stack</span>
            </div>
          </div>

          <dl class="case-meta">
            <div data-reveal style="--i: 0">
              <dt>Role</dt><dd>Product design<br />Full-stack development</dd>
            </div>
            <div data-reveal style="--i: 1">
              <dt>Surface</dt><dd>Commerce<br />Knowledge & operations</dd>
            </div>
            <div data-reveal style="--i: 2">
              <dt>System</dt><dd>Next.js · React<br />TypeScript · MongoDB</dd>
            </div>
            <div data-reveal style="--i: 3">
              <dt>Ownership</dt><dd>Direction through<br />implementation</dd>
            </div>
          </dl>
        </header>

        <div class="wave-divider case-wave" data-loop aria-hidden="true">
          <svg viewBox="0 0 2880 96" preserveAspectRatio="none">
            <path
              d="M0 51c80-42 160 42 240 0s160 42 240 0s160 42 240 0s160 42 240 0s160 42 240 0s160 42 240 0s160 42 240 0s160 42 240 0s160 42 240 0s160 42 240 0s160 42 240 0s160 42 240 0v45H0Z"
            ></path>
          </svg>
        </div>

        <div class="case-body">
          <nav class="case-nav" aria-label="Case study sections">
            <span>On this reel</span>
            <a href="#brief">The brief</a>
            <a href="#storefront">Public product</a>
            <a href="#mobile">Mobile</a>
            <a href="#knowledge">Connected knowledge</a>
            <a href="#operations">Operations</a>
            <a href="#decisions">Decisions</a>
          </nav>

          <div class="case-content">
            <section class="case-section case-opening" id="brief" data-reveal>
              <h2>A storefront was only the visible half.</h2>
              <div class="case-columns">
                <p class="case-lede">
                  HLP Labs needed to sell a technical catalog without flattening
                  it into a conventional shop. Products, scientific context,
                  guidance, and internal operations had to behave like one
                  product.
                </p>
                <div>
                  <p>
                    The work combined a public commerce experience with an
                    encyclopedia, guides, a calculator, an AI assistant, search,
                    account and order flows, and an administrative surface for
                    running the catalog and content.
                  </p>
                  <p>
                    My role covered the experience and the implementation. That
                    changed the questions from “what should this screen look
                    like?” to “what information must travel through the whole
                    system so this remains clear and operable?”
                  </p>
                </div>
              </div>
            </section>

            <figure
              class="case-screen case-screen-wide"
              id="storefront"
              data-reveal
            >
              <div class="screen-window has-film" data-loop>
                <div class="screen-bar" aria-hidden="true">
                  <span></span><span></span><span></span><b>Public storefront</b
                  >
                </div>
                <img
                  src="/assets/projects/hlp/storefront-live.png"
                  alt="HLP Labs public storefront on desktop: a dark hero with a product vial, a headline in Bulgarian, and catalog navigation"
                  width="1440"
                  height="1000"
                  loading="lazy"
                />
                <FilmStatic />
                <span class="screen-hint" aria-hidden="true"
                  >Hover to develop</span
                >
              </div>
              <figcaption>
                <strong>The public product</strong><span
                  >The current experience leads with research context, then
                  gives the catalog a clear path into products and supporting
                  knowledge.</span
                >
              </figcaption>
            </figure>

            <section class="case-section" data-reveal>
              <h2>Clarity before conversion.</h2>
              <div class="decision-row">
                <div data-reveal style="--i: 0">
                  <strong>Start with intent</strong><p>
                    Navigation separates shopping, learning, and support without
                    turning them into isolated destinations.
                  </p>
                </div>
                <div data-reveal style="--i: 1">
                  <strong>Keep context nearby</strong><p>
                    Technical products connect to educational material so the
                    next useful answer is part of the journey.
                  </p>
                </div>
                <div data-reveal style="--i: 2">
                  <strong>Design the small screen</strong><p>
                    Discovery, reading, and product evaluation remain deliberate
                    on mobile instead of becoming a compressed desktop page.
                  </p>
                </div>
              </div>
            </section>

            <div class="case-proof-pair">
              <figure data-reveal style="--i: 0">
                <div class="screen-window has-film" data-loop>
                  <div class="screen-bar" aria-hidden="true">
                    <span></span><span></span><span></span><b>Product detail</b>
                  </div>
                  <img
                    src="/assets/projects/hlp/product-live.png"
                    alt="HLP Labs product detail page with a vial photo, specification card, variant selection, and add-to-cart action"
                    width="1440"
                    height="1000"
                    loading="lazy"
                  />
                  <FilmStatic />
                </div>
                <figcaption>
                  <strong>Technical detail, kept legible</strong><span
                    >Selection, evidence, product context, and the primary
                    action share one controlled hierarchy.</span
                  >
                </figcaption>
              </figure>
              <figure data-reveal style="--i: 1">
                <div class="screen-window has-film" data-loop>
                  <div class="screen-bar" aria-hidden="true">
                    <span></span><span></span><span></span><b>Resource hub</b>
                  </div>
                  <img
                    src="/assets/projects/hlp/resources-live.png"
                    alt="HLP Labs resources hub listing encyclopedia entries, articles, and guides in a card grid"
                    width="1440"
                    height="1000"
                    loading="lazy"
                  />
                  <FilmStatic />
                </div>
                <figcaption>
                  <strong>Learning is part of the product</strong><span
                    >Reference material, articles, answers, and tools sit beside
                    the catalog instead of behind it.</span
                  >
                </figcaption>
              </figure>
            </div>

            <section class="mobile-proof" id="mobile" data-reveal data-loop>
              <div class="mobile-copy">
                <h2>Mobile is a product surface, not a resize.</h2>
                <p>
                  Long scientific content, product controls, navigation, and
                  assistance all compete for a narrow viewport. The hierarchy
                  was tuned for thumb reach, reading rhythm, and decisive next
                  actions.
                </p>
              </div>
              <div class="phone-stage">
                <div class="phone-shell">
                  <div class="phone-screen has-film">
                    <img
                      src="/assets/projects/hlp/mobile-live.png"
                      alt="HLP Labs mobile landing screen with a compact header, headline, product vial, carousel dots, and two stacked actions"
                      width="390"
                      height="844"
                      loading="lazy"
                    />
                    <FilmStatic />
                  </div>
                </div>
                <div class="thumb-zone" aria-hidden="true">
                  <span>Thumb reach</span>
                </div>
              </div>
            </section>

            <section
              class="case-section knowledge-section"
              id="knowledge"
              data-reveal
            >
              <h2>One connected knowledge system.</h2>
              <p class="case-lede">
                The catalog is easier to use when products are not dead ends.
                HLP Labs connects discovery with structured explanations,
                practical guides, and calculation tools.
              </p>
              <div
                class="system-map"
                data-loop
                role="img"
                aria-label="Diagram: the catalog sits at the center and connects to the encyclopedia, guides, calculator, and AI assistant"
              >
                <svg viewBox="0 0 1000 500" aria-hidden="true">
                  {
                    spokes.map((node) => (
                      <path
                        class="system-wire"
                        d={`M${hub.x} ${hub.y} C ${(hub.x + node.x) / 2} ${hub.y}, ${(hub.x + node.x) / 2} ${node.y}, ${node.x} ${node.y}`}
                      />
                    ))
                  }
                </svg>
                {
                  systemNodes.map((node) => (
                    <div
                      class:list={[
                        'system-node',
                        `node-${node.id}`,
                        node.tone && `node-tone-${node.tone}`,
                      ]}
                      style={`--x: ${node.x / 10}%; --y: ${node.y / 5}%;`}
                    >
                      <span>{node.label}</span>
                      <small>{node.note}</small>
                    </div>
                  ))
                }
              </div>
            </section>

            <figure class="case-screen assistant-proof" data-reveal>
              <div class="screen-window has-film" data-loop>
                <div class="screen-bar" aria-hidden="true">
                  <span></span><span></span><span></span><b
                    >Contextual assistant</b
                  >
                </div>
                <img
                  src="/assets/projects/hlp/assistant.jpg"
                  alt="HLP Labs AI assistant panel answering a product question inside the storefront"
                  width="1600"
                  height="1000"
                  loading="lazy"
                />
                <FilmStatic />
              </div>
              <figcaption>
                <strong>Answers stay inside the product</strong><span
                  >The assistant extends support and discovery without sending
                  visitors out of the experience to assemble context themselves.</span
                >
              </figcaption>
            </figure>

            <section
              class="case-section operations-section"
              id="operations"
              data-reveal
            >
              <h2>The back office belongs in the design.</h2>
              <p class="case-lede">
                A polished storefront becomes fragile if the people behind it
                cannot keep products, content, and orders accurate. The
                administrative surface was treated as part of the same product
                system.
              </p>
              <div class="operations-frame">
                <div class="screen-window has-film" data-loop>
                  <div class="screen-bar" aria-hidden="true">
                    <span></span><span></span><span></span><b>Administration</b>
                  </div>
                  <img
                    src="/assets/projects/hlp/admin.jpg"
                    alt="HLP Labs administration dashboard listing blog and encyclopedia entries with status, visibility, and filters"
                    width="1600"
                    height="1000"
                    loading="lazy"
                  />
                  <FilmStatic />
                </div>
                <div class="admin-callout callout-a" data-reveal style="--i: 0">
                  <span>Catalog</span><p>
                    Products and taxonomy in one operational model.
                  </p>
                </div>
                <div class="admin-callout callout-b" data-reveal style="--i: 1">
                  <span>Content</span><p>
                    Scientific resources connect back to the public journey.
                  </p>
                </div>
                <div class="admin-callout callout-c" data-reveal style="--i: 2">
                  <span>Orders</span><p>
                    Commerce activity stays visible to the team running it.
                  </p>
                </div>
              </div>
            </section>

            <section
              class="case-section decisions-section"
              id="decisions"
              data-reveal
            >
              <h2>What the work demonstrates.</h2>
              <div class="decision-ledger">
                <div data-reveal style="--i: 0">
                  <strong>Design the relationships</strong><p>
                    The main artifact is not any single page. It is the
                    connection between catalog, knowledge, assistance, and
                    operations.
                  </p>
                </div>
                <div data-reveal style="--i: 1">
                  <strong>Make complexity legible</strong><p>
                    Technical subject matter needs hierarchy and context, not
                    simply more copy or more controls.
                  </p>
                </div>
                <div data-reveal style="--i: 2">
                  <strong>Own both sides of the promise</strong><p>
                    The public experience and the systems behind it were shaped
                    together, reducing the distance between intent and
                    implementation.
                  </p>
                </div>
                <div data-reveal style="--i: 3">
                  <strong>Ship evidence, not claims</strong><p>
                    The result is a live product with real customer, content,
                    commerce, and administrative surfaces.
                  </p>
                </div>
              </div>
            </section>

            <section class="case-next" data-reveal>
              <div>
                <h2>
                  <span class="title-line">Need this mix</span>
                  <span class="title-line title-outline">on your team?</span>
                </h2>
                <p>
                  I work best on products where experience quality and technical
                  depth both matter.
                </p>
              </div>
              <a
                class="button button-light button-large"
                href="/#top"
                data-squash
              >
                Back to the reel <ArrowIcon />
              </a>
            </section>
          </div>
        </div>
      </article>
    </main>
  </div>
</BaseLayout>
