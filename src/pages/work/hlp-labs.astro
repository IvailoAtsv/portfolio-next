---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StudioNav from '../../components/StudioNav.astro';
import ArrowIcon from '../../components/ArrowIcon.astro';
import FilmStatic from '../../components/FilmStatic.astro';
import ProjectVideo from '../../components/ProjectVideo.astro';
import CircleWords from '../../components/CircleWords.astro';
import { pages } from '../../lib/site';

const systemNodes = [
  {
    id: 'catalog',
    label: 'Catalog',
    note: 'Peptides by research area',
    x: 500,
    y: 250,
    tone: 'red',
  },
  {
    id: 'encyclopedia',
    label: 'Encyclopedia',
    note: 'What each peptide does',
    x: 175,
    y: 95,
  },
  {
    id: 'guides',
    label: 'Blog & FAQ',
    note: 'Storage, preparation, handling',
    x: 825,
    y: 95,
    tone: 'yellow',
  },
  {
    id: 'calculator',
    label: 'Calculator',
    note: 'Dilution and concentration',
    x: 175,
    y: 405,
  },
  {
    id: 'assistant',
    label: 'AI assistant',
    note: 'A goal in, an article out',
    x: 825,
    y: 405,
    tone: 'green',
  },
];
const hub = systemNodes[0];
const spokes = systemNodes.slice(1);
---

<BaseLayout page={pages.hlpLabs}>
  <div class="site-shell case-shell">
    <StudioNav />

    <main id="main-content">
      <article class="case-study">
        <header class="case-hero" data-motion-group>
          <div class="case-heading">
            <a class="pill-link back-link" href="/#work">
              <ArrowIcon direction="left" /> Back to the reel
            </a>
            <h1 class="hero-title" data-motion="title">
              <span class="title-line">HLP</span>
              <span class="title-line title-outline">Labs.</span>
            </h1>
            <p data-motion="copy">
              HLP Labs is a Bulgarian online shop for research peptides. I
              designed and built the storefront, the reference library that sits
              beside it, the admin panel the team runs both from, and the SEO
              system that grew it. The day Google indexed the rewritten pages,
              the site matched its previous month of organic reach in 24 hours.
            </p>
            <div class="case-actions" data-motion="action">
              <a
                class="button button-dark"
                href="https://www.hlplabs.com"
                target="_blank"
                rel="noreferrer"
                data-squash
              >
                Visit the live site <ArrowIcon direction="external" />
              </a>
              <a class="button button-paper" href="#growth" data-squash>
                How the traffic grew <ArrowIcon direction="down" />
              </a>
            </div>
          </div>

          <div class="hero-stage case-stage" data-loop>
            <div class="hero-cel cel-enter has-film">
              <img
                src="/assets/generated/hlp-lab-scene-v2.webp"
                alt="A friendly vial character points at a microscope slide beside a laboratory specimen cabinet"
                width="1400"
                height="1000"
                fetchpriority="high"
              />
              <FilmStatic />
            </div>
            <div class="stage-sign stage-sign-red" aria-hidden="true">
              <span>Product design</span>
              <i>×</i>
              <span>Full-stack</span>
            </div>
          </div>

          <dl class="case-meta">
            <div data-reveal style="--i: 0">
              <dt>Role</dt><dd>Product design<br />Full-stack development</dd>
            </div>
            <div data-reveal style="--i: 1">
              <dt>Product</dt><dd>
                Online shop<br />Library · Admin · SEO system
              </dd>
            </div>
            <div data-reveal style="--i: 2">
              <dt>System</dt><dd>Next.js · React<br />TypeScript · MongoDB</dd>
            </div>
            <div data-reveal style="--i: 3">
              <dt>Outcome</dt><dd>
                A month of reach in 24 hours<br />#1 for many peptide queries
              </dd>
            </div>
          </dl>
        </header>

        <div class="wave-divider case-wave" data-loop aria-hidden="true">
          <svg viewBox="0 0 2880 96" preserveAspectRatio="none">
            <path
              d="M0 51c80-42 160 42 240 0s160 42 240 0s160 42 240 0s160 42 240 0s160 42 240 0s160 42 240 0s160 42 240 0s160 42 240 0s160 42 240 0s160 42 240 0s160 42 240 0s160 42 240 0v80H0Z"
            ></path>
          </svg>
        </div>

        <div class="case-body">
          <nav
            class="case-nav"
            aria-label="Case study sections"
            data-motion-group
          >
            <span data-motion="detail" data-motion-order="0">On this reel</span>
            <a href="#brief" data-motion="detail">What it is</a>
            <a href="#growth" data-motion="detail">Growth</a>
            <a href="#storefront" data-motion="detail">The storefront</a>
            <a href="#mobile" data-motion="detail">On a phone</a>
            <a href="#checkout-motion" data-motion="detail">The order button</a>
            <a href="#knowledge" data-motion="detail">The library</a>
            <a href="#instagram" data-motion="detail">Instagram</a>
            <a href="#operations" data-motion="detail">The admin panel</a>
            <a href="#decisions" data-motion="detail">Decisions</a>
          </nav>

          <div class="case-content">
            <dl
              class="hlp-stats"
              aria-label="What the SEO and content systems did for HLP Labs"
              data-motion-group
            >
              <div data-motion="detail">
                <dt>24h</dt>
                <dd>
                  to match a full month of organic reach, counted from the day
                  Google indexed the rewritten pages.
                </dd>
              </div>
              <div data-motion="detail">
                <dt>#1</dt>
                <dd>
                  for many peptide queries, above the largest shops in the
                  Bulgarian market.
                </dd>
              </div>
              <div data-motion="detail">
                <dt>7</dt>
                <dd>
                  parts to the SEO system, from reading the studies to watching
                  the rankings. All of it runs without a person.
                </dd>
              </div>
              <div data-motion="detail">
                <dt>0</dt>
                <dd>
                  unsourced claims on Instagram. Every finding on a slide stays
                  linked to the study it came from.
                </dd>
              </div>
            </dl>

            <section
              class="case-section case-opening"
              id="brief"
              data-motion-group
            >
              <h2 data-motion="title">A shop with a library attached.</h2>
              <div class="case-columns">
                <p class="case-lede" data-motion="copy">
                  Nobody buys a research peptide on impulse. Someone looking at
                  Retatrutide wants to know the mechanism, how to store it and
                  how to dilute it before the add-to-cart button matters. So the
                  brief was a storefront and a reference library, built as one
                  site.
                </p>
                <div>
                  <p data-motion="copy">
                    The public site has a catalog sorted by research area, an
                    encyclopedia, a blog of how-to guides, an FAQ, a dilution
                    calculator, an AI assistant, search, accounts and order
                    history. Behind it is an admin panel for the catalog and all
                    of that content, and two AI systems: one that keeps the
                    pages ranking, one that turns studies into Instagram posts.
                    Everything is in Bulgarian, because that is where the
                    customers are.
                  </p>
                  <p data-motion="copy">
                    I designed the screens and built the system. That includes
                    the data model behind a product page, which has to carry a
                    CAS number, a formula, molecular weight, purity, sizes and
                    price, and then a long article about the mechanism
                    underneath.
                  </p>
                </div>
              </div>
            </section>

            <section
              class="case-section growth-section"
              id="growth"
              data-motion-group
            >
              <h2 data-motion="title">A month of reach in a day.</h2>
              <div class="case-columns">
                <p class="case-lede" data-motion="copy">
                  Before the rewrite, HLP Labs collected a month of organic
                  visits in a month. The day Google indexed the new pages, it
                  collected the same number in 24 hours. For many peptide
                  queries the site now sits at position one, above the biggest
                  shops in the Bulgarian market.
                </p>
                <div>
                  <p data-motion="copy">
                    The pages kept their shape. What changed is what is on them.
                    Every product page now carries copy backed by the studies, a
                    title and description written for the query people actually
                    type, an FAQ, structured data with the live price and stock,
                    and internal links to the encyclopedia entry and the guide
                    that answer the next question.
                  </p>
                  <p data-motion="copy">
                    None of that was done by hand. I built an SEO system in
                    seven parts that does it, and it keeps going after the page
                    is live: rankings, indexed pages and organic traffic are
                    tracked, so a page that slips gets sent back through the
                    loop.
                  </p>
                </div>
              </div>
              <ol
                class="seo-pipeline"
                aria-label="The seven parts of the SEO system"
                data-motion="detail"
              >
                <li>
                  <strong>Research and content</strong><span
                    >Reads the studies and the existing product information,
                    finds the topics nobody has covered, and rewrites product
                    copy with evidence behind each claim.</span
                  >
                </li>
                <li>
                  <strong>Keywords</strong><span
                    >Maps search terms to products and stops two pages from
                    competing for the same term.</span
                  >
                </li>
                <li>
                  <strong>On-page</strong><span
                    >Writes page titles, meta descriptions, headings, FAQs,
                    image text and internal links.</span
                  >
                </li>
                <li>
                  <strong>Technical</strong><span
                    >Manages canonical URLs, sitemap entries, indexability and
                    server-rendered content, so Google reads the same page a
                    customer does.</span
                  >
                </li>
                <li>
                  <strong>Structured data</strong><span
                    >Generates Product, Offer or AggregateOffer schema with the
                    correct price, currency, availability and variants.</span
                  >
                </li>
                <li>
                  <strong>Validation</strong><span
                    >Checks the rendered HTML and the JSON-LD for errors before
                    the page is submitted for reindexing.</span
                  >
                </li>
                <li>
                  <strong>Monitoring</strong><span
                    >Tracks rankings, indexed pages and organic traffic, and
                    flags weak pages so they can be updated again.</span
                  >
                </li>
              </ol>
            </section>

            <figure
              class="case-screen case-screen-wide"
              id="storefront"
              data-motion-group
            >
              <div
                class="screen-window has-film"
                data-loop
                data-motion="cel"
                data-motion-order="0"
              >
                <div class="screen-bar" aria-hidden="true">
                  <span></span><span></span><span></span><b>Public storefront</b
                  >
                </div>
                <img
                  src="/assets/projects/hlp/storefront-live.png"
                  alt="HLP Labs public storefront on desktop: a dark hero with a product vial, a headline in Bulgarian, and catalog navigation"
                  width="1440"
                  height="1000"
                  loading="lazy"
                />
                <FilmStatic />
                <span class="screen-hint" aria-hidden="true"
                  >Hover to develop</span
                >
              </div>
              <figcaption>
                <strong data-motion="detail" data-motion-order="1"
                  >The home page</strong
                ><span data-motion="copy" data-motion-order="2"
                  >One peptide in the spotlight, a carousel of the others, then
                  the catalog by research area. The header has two entries: Shop
                  and Resources.</span
                >
              </figcaption>
            </figure>

            <section class="case-section" data-motion-group>
              <h2 data-motion="title">Shop, Resources, then the spec.</h2>
              <div class="decision-row">
                <div data-motion-group>
                  <strong data-motion="title">Two doors in the header</strong><p
                    data-motion="copy"
                  >
                    Shop and Resources. The shop menu opens into research areas
                    like weight regulation, longevity and recovery, so you can
                    start from a goal without knowing a product name.
                  </p>
                </div>
                <div data-motion-group>
                  <strong data-motion="title">Spec on top, article below</strong
                  ><p data-motion="copy">
                    Every product page puts the label, sizes and price first.
                    The article on the mechanism starts underneath. You can buy
                    in two clicks or read for ten minutes.
                  </p>
                </div>
                <div data-motion-group>
                  <strong data-motion="title">Dark by default</strong><p
                    data-motion="copy"
                  >
                    The shop opens in a dark theme. A sun icon in the header
                    switches to light. The captures on this page are the dark
                    version, which is how most visitors first see it.
                  </p>
                </div>
              </div>
            </section>

            <div class="case-proof-pair">
              <figure data-motion-group>
                <div
                  class="screen-window has-film"
                  data-loop
                  data-motion="cel"
                  data-motion-order="0"
                >
                  <div class="screen-bar" aria-hidden="true">
                    <span></span><span></span><span></span><b>Product detail</b>
                  </div>
                  <img
                    src="/assets/projects/hlp/product-live.png"
                    alt="HLP Labs product detail page with a vial photo, specification card, variant selection, and add-to-cart action"
                    width="1440"
                    height="1000"
                    loading="lazy"
                  />
                  <FilmStatic />
                </div>
                <figcaption>
                  <strong data-motion="detail" data-motion-order="1"
                    >Retatrutide, the product page</strong
                  ><span data-motion="copy" data-motion-order="2"
                    >The label carries the CAS number, formula and molecular
                    weight. Three sizes, the price, delivery and purity notes,
                    then add to cart. The mechanism article begins below.</span
                  >
                </figcaption>
              </figure>
              <figure data-motion-group>
                <div
                  class="screen-window has-film"
                  data-loop
                  data-motion="cel"
                  data-motion-order="0"
                >
                  <div class="screen-bar" aria-hidden="true">
                    <span></span><span></span><span></span><b>Resource hub</b>
                  </div>
                  <img
                    src="/assets/projects/hlp/resources-live.png"
                    alt="HLP Labs resources hub listing encyclopedia entries, articles, and guides in a card grid"
                    width="1440"
                    height="1000"
                    loading="lazy"
                  />
                  <FilmStatic />
                </div>
                <figcaption>
                  <strong data-motion="detail" data-motion-order="1"
                    >Resources</strong
                  ><span data-motion="copy" data-motion-order="2"
                    >Encyclopedia, blog, FAQ and calculator, one card each. The
                    intro says what is inside: how to store, prepare and work
                    with peptides.</span
                  >
                </figcaption>
              </figure>
            </div>

            <section
              class="mobile-proof"
              id="mobile"
              data-motion-group
              data-loop
            >
              <div class="mobile-copy">
                <h2 data-motion="title">Laid out for one hand.</h2>
                <p data-motion="copy">
                  On a phone the headline and the vial each get the full width,
                  and the two buttons sit where a thumb rests. The catalog
                  navigation folds into the menu. Same page, same content,
                  arranged for one hand.
                </p>
              </div>
              <div class="phone-stage" data-motion="cel">
                <div class="phone-cluster">
                  <div class="phone-shell">
                    <div class="phone-screen has-film">
                      <img
                        src="/assets/projects/hlp/mobile-live.png"
                        alt="HLP Labs mobile landing screen with a compact header, headline, product vial, carousel dots, and two stacked actions"
                        width="390"
                        height="844"
                        loading="lazy"
                      />
                      <FilmStatic />
                      <div class="thumb-arc" aria-hidden="true"></div>
                    </div>
                    <span class="thumb-label" aria-hidden="true"
                      >Thumb reach</span
                    >
                  </div>
                </div>
              </div>
            </section>

            <section
              class="checkout-showcase case-section"
              id="checkout-motion"
              data-motion-group
            >
              <div class="checkout-story">
                <h2 data-motion="title">The order button is a short film.</h2>
                <p class="case-lede" data-motion="copy">
                  Confirm the order and a parcel slides into a truck. The doors
                  close, the road starts moving and the truck drives off. All of
                  it happens inside the button, while the order summary above
                  stays still.
                </p>
                <p data-motion="copy">
                  It is one sequence of connected states, so the parcel sitting
                  in the idle button is the same parcel that ends up in the
                  trailer. Each movement starts where the previous one stopped.
                </p>
                <figure class="checkout-closeup">
                  <ProjectVideo
                    src="/assets/projects/hlp/checkout-detail.mp4"
                    poster="/assets/projects/hlp/checkout-detail-poster.png"
                    label="Close-up of the parcel loading into the checkout truck and driving away"
                    width={244}
                    height={60}
                  />
                  <figcaption>
                    The button on its own, enlarged from the recording.
                  </figcaption>
                </figure>
                <p class="checkout-detail-note">
                  A second tap during the animation is ignored, timers are
                  cleared if the screen unmounts, and with reduced motion the
                  button shows a plain confirmation state.
                </p>
              </div>
              <figure class="checkout-recording" data-loop>
                <div class="checkout-phone">
                  <ProjectVideo
                    src="/assets/projects/hlp/checkout-motion.mp4"
                    poster="/assets/projects/hlp/checkout-poster.png"
                    label="HLP Labs checkout animation in the original mobile recording"
                    width={288}
                    height={636}
                  />
                </div>
                <span class="reel-seal checkout-seal" aria-hidden="true">
                  <CircleWords
                    id="checkout-seal-ring"
                    words={['PACK', 'SHIP', 'CONFIRM']}
                    separator="·"
                    radius={43}
                    size={120}
                  >
                    <circle class="seal-disc" slot="back" cx="60" cy="60" r="58"
                    ></circle>
                    <circle class="seal-dot" cx="60" cy="60" r="5"></circle>
                  </CircleWords>
                </span>
                <figcaption>
                  The original phone recording of a demo order. The button is in
                  the bottom bar.
                </figcaption>
              </figure>
            </section>

            <section
              class="case-section knowledge-section"
              id="knowledge"
              data-motion-group
            >
              <h2 data-motion="title">Every product links to an answer.</h2>
              <p class="case-lede" data-motion="copy">
                A product page raises questions the buy box cannot settle. What
                does this peptide do? How do I store it? How much do I dilute
                it? The encyclopedia, the guides, the calculator and the
                assistant each answer one kind of question, and each links back
                to the catalog.
              </p>
              <div
                class="system-map"
                data-loop
                data-motion-group
                role="img"
                aria-label="Diagram: the catalog sits at the center and connects to the encyclopedia, the blog and FAQ, the calculator, and the AI assistant"
              >
                <svg
                  viewBox="0 0 1000 500"
                  aria-hidden="true"
                  data-motion="line"
                  data-motion-order="1"
                >
                  {
                    spokes.map((node, index) => (
                      <path
                        class="system-wire"
                        style={`--wire-order: ${index};`}
                        d={`M${hub.x} ${hub.y} C ${(hub.x + node.x) / 2} ${hub.y}, ${(hub.x + node.x) / 2} ${node.y}, ${node.x} ${node.y}`}
                      />
                    ))
                  }
                </svg>
                {
                  systemNodes.map((node, index) => (
                    <div
                      class:list={[
                        'system-node',
                        `node-${node.id}`,
                        node.tone && `node-tone-${node.tone}`,
                      ]}
                      style={`--x: ${node.x / 10}%; --y: ${node.y / 5}%;`}
                      data-motion="stamp"
                      data-motion-order={index === 0 ? 0 : index + 1}
                    >
                      <span>{node.label}</span>
                      <small>{node.note}</small>
                    </div>
                  ))
                }
              </div>
            </section>

            <figure class="case-screen assistant-proof" data-motion-group>
              <div
                class="screen-window has-film"
                data-loop
                data-motion="cel"
                data-motion-order="0"
              >
                <div class="screen-bar" aria-hidden="true">
                  <span></span><span></span><span></span><b
                    >Contextual assistant</b
                  >
                </div>
                <img
                  src="/assets/projects/hlp/assistant.jpg"
                  alt="HLP Labs AI assistant panel answering a product question inside the storefront"
                  width="1600"
                  height="1000"
                  loading="lazy"
                />
                <FilmStatic />
              </div>
              <figcaption>
                <strong data-motion="detail" data-motion-order="1"
                  >The assistant</strong
                ><span data-motion="copy" data-motion-order="2"
                  >Type a question or pick a goal such as more energy or faster
                  recovery, and it replies with an article or a product from the
                  shop. It opens over whatever page you are on.</span
                >
              </figcaption>
            </figure>

            <section
              class="case-section instagram-section"
              id="instagram"
              data-motion-group
            >
              <h2 data-motion="title">
                A study goes in. A carousel comes out.
              </h2>
              <div class="case-columns">
                <p class="case-lede" data-motion="copy">
                  The same evidence feeds Instagram. The content flow takes
                  scientific studies and product research as input, pulls out
                  the findings worth sharing, and turns them into a carousel, a
                  caption and a set of source notes.
                </p>
                <div>
                  <p data-motion="copy">
                    Each claim stays connected to the study it came from, all
                    the way to the finished slide. For a shop whose customers
                    read papers, that is the rule that makes the posts worth
                    anything: nothing on a slide is unsourced, and the source
                    notes say where each number came from.
                  </p>
                  <p data-motion="copy">
                    The finished post is saved for review. Someone on the team
                    reads it and decides whether it goes out. The AI does the
                    reading and the drafting. It does not publish.
                  </p>
                </div>
              </div>
              <ol
                class="content-flow"
                aria-label="Instagram content flow"
                data-motion="detail"
              >
                <li>
                  <strong>Studies in</strong><span
                    >Papers and product research, as published</span
                  >
                </li>
                <li>
                  <strong>Findings out</strong><span
                    >Each one still tied to its source</span
                  >
                </li>
                <li>
                  <strong>Post drafted</strong><span
                    >Carousel, caption and source notes</span
                  >
                </li>
                <li>
                  <strong>Held for review</strong><span
                    >A person approves before it is published</span
                  >
                </li>
              </ol>
            </section>

            <section
              class="case-section operations-section"
              id="operations"
              data-motion-group
            >
              <h2 data-motion="title">The admin panel is half the product.</h2>
              <p class="case-lede" data-motion="copy">
                A shop with this much writing in it falls apart if the team
                cannot edit it. The admin panel covers products, categories,
                orders, banners, blog posts, encyclopedia entries and the FAQ.
                Every list has the same filters and the same status column.
              </p>
              <div class="operations-frame" data-motion-group>
                <div
                  class="screen-window has-film"
                  data-loop
                  data-motion="cel"
                  data-motion-order="0"
                >
                  <div class="screen-bar" aria-hidden="true">
                    <span></span><span></span><span></span><b>Administration</b>
                  </div>
                  <img
                    src="/assets/projects/hlp/admin.jpg"
                    alt="HLP Labs administration dashboard listing blog and encyclopedia entries with status, visibility, and filters"
                    width="1600"
                    height="1000"
                    loading="lazy"
                  />
                  <FilmStatic />
                </div>
                <div
                  class="admin-callout callout-a"
                  data-motion="stamp"
                  data-motion-order="1"
                >
                  <span>Catalog</span><p>
                    Products, categories and orders. New orders show up as a
                    badge in the sidebar.
                  </p>
                </div>
                <div
                  class="admin-callout callout-b"
                  data-motion="stamp"
                  data-motion-order="2"
                >
                  <span>Content</span><p>
                    Blog posts and encyclopedia entries, each with a draft or
                    published state and its own categories.
                  </p>
                </div>
                <div
                  class="admin-callout callout-c"
                  data-motion="stamp"
                  data-motion-order="3"
                >
                  <span>Filters</span><p>
                    Search by title, then narrow by status, category and
                    visibility. The capture shows the blog list.
                  </p>
                </div>
              </div>
            </section>

            <section
              class="case-section decisions-section"
              id="decisions"
              data-motion-group
            >
              <h2 data-motion="title">Five decisions I'd make again.</h2>
              <div class="decision-ledger">
                <div data-motion-group>
                  <strong data-motion="title"
                    >One app for shop and library</strong
                  ><p data-motion="copy">
                    A single Next.js app on one MongoDB database. The
                    storefront, the library and the admin panel read the same
                    records, so there is no second system to keep in sync when a
                    product or an article changes.
                  </p>
                </div>
                <div data-motion-group>
                  <strong data-motion="title">Spec first, essay second</strong
                  ><p data-motion="copy">
                    The product page shows the label, sizes and price above the
                    fold and keeps the mechanism article below. A customer who
                    already knows what they want is not made to scroll past it.
                  </p>
                </div>
                <div data-motion-group>
                  <strong data-motion="title">Bulgarian all the way down</strong
