---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StudioNav from '../../components/StudioNav.astro';
import ArrowIcon from '../../components/ArrowIcon.astro';
import { pages } from '../../lib/site';

const assets = '/assets/projects/sellphy';
---

<BaseLayout page={pages.sellphy}>
  <div class="site-shell case-shell sellphy-case">
    <StudioNav />
    <main id="main-content">
      <article class="case-study">
        <header class="case-hero sellphy-hero" data-motion-group>
          <div class="case-heading">
            <a class="pill-link back-link" href="/#work">
              <ArrowIcon direction="left" /> Back to the reel
            </a>
            <h1 class="hero-title" data-motion="title">
              Sellphy<span class="title-outline">.</span>
            </h1>
            <p data-motion="copy">
              Sellphy is a shop platform I designed and built. A seller sets up
              a storefront in a six-step editor, manages products and orders
              from one dashboard, and gets a site served as static HTML. Serving
              those pages from a small VPS cut my hosting bill by 83%.
            </p>
            <div class="case-actions" data-motion="action">
              <a class="button button-dark" href="#builder" data-squash>
                How a shop gets built <ArrowIcon direction="down" />
              </a>
            </div>
          </div>

          <figure class="sellphy-stage" data-motion="cel" data-motion-order="2">
            <a
              class="screen-window"
              href={`${assets}/builder.webp`}
              target="_blank"
              rel="noreferrer"
              aria-label="Open the Sellphy site builder screenshot at full size"
            >
              <div class="screen-bar" aria-hidden="true">
                <span></span><span></span><span></span><b
                  >Site editor / step 2 of 6</b
                >
              </div>
              <img
                src={`${assets}/builder.webp`}
                alt="Sellphy site editor on step 2 of 6, with a live preview of a video homepage hero and layout variants in the right panel"
                width="1024"
                height="661"
                fetchpriority="high"
              />
            </a>
            <figcaption>
              Step 2 of 6 in the site editor: the homepage. The preview in the
              middle is the real public page.<br /><span
                >Demo shop. Select to enlarge.</span
              >
            </figcaption>
          </figure>

          <dl class="case-meta">
            <div data-motion="detail">
              <dt>Role</dt><dd>Product design<br />Full-stack development</dd>
            </div>
            <div data-motion="detail">
              <dt>Product</dt><dd>
                Shop platform<br />Storefronts · Seller dashboard
              </dd>
            </div>
            <div data-motion="detail">
              <dt>System</dt><dd>
                Next.js · TypeScript<br />MongoDB · Docker on Hetzner
              </dd>
            </div>
            <div data-motion="detail">
              <dt>Outcome</dt><dd>
                83% lower hosting cost<br />25+ hours saved a month
              </dd>
            </div>
          </dl>
        </header>

        <div class="wave-divider case-wave" data-loop aria-hidden="true">
          <svg viewBox="0 0 2880 96" preserveAspectRatio="none"
            ><path
              d="M0 51c80-42 160 42 240 0s160 42 240 0s160 42 240 0s160 42 240 0s160 42 240 0s160 42 240 0s160 42 240 0s160 42 240 0s160 42 240 0s160 42 240 0s160 42 240 0s160 42 240 0v80H0Z"
            ></path></svg
          >
        </div>

        <div class="case-body">
          <nav class="case-nav" aria-label="Case study sections">
            <span>On this reel</span>
            <a href="#builder">The editor</a>
            <a href="#product-pages">Product pages</a>
            <a href="#dashboard">The dashboard</a>
            <a href="#tours">Tours</a>
            <a href="#static">Static pages</a>
          </nav>

          <div class="case-content">
            <section
              class="case-section case-opening"
              id="builder"
              data-motion-group
            >
              <h2 data-motion="title">A shop in six steps.</h2>
              <div class="case-columns">
                <p class="case-lede" data-motion="copy">
                  The site editor walks a new seller through layout, homepage,
                  shop page, navigation, colors and fonts. Most of the work is
                  in the homepage step: each section has a handful of variants,
                  including a video hero, and the preview in the middle is
                  rendered with the same components as the live shop.
                </p>
                <div>
                  <p data-motion="copy">
                    You can click a heading in the preview and type straight
                    into it, so there is no hunting for the matching field in
                    the side panel. A product grid in the editor is the grid the
                    customer will see.
                  </p>
                  <p data-motion="copy">
                    When the six steps are done the shop is live on a
                    sellphy.store subdomain. Connecting a custom domain is a
                    dashboard setting.
                  </p>
                </div>
              </div>
              <ol
                class="setup-sequence"
                aria-label="Site editor steps"
                data-motion="detail"
              >
                <li>
                  <strong>Layout</strong><span>Width, corners, spacing</span>
                </li>
                <li>
                  <strong>Home</strong><span>Sections and their variants</span>
                </li>
                <li>
                  <strong>Shop</strong><span>The catalog page</span>
                </li>
                <li>
                  <strong>Navigation</strong><span>Menu and footer</span>
                </li>
                <li>
                  <strong>Colors</strong><span>A preset or your own</span>
                </li>
                <li>
                  <strong>Fonts</strong><span>Heading and body pair</span>
                </li>
              </ol>
            </section>

            <section class="case-section" id="product-pages" data-motion-group>
              <h2 data-motion="title">
                One product page,<br />three shops.
              </h2>
              <div class="case-columns">
                <p class="case-lede" data-motion="copy">
                  Every shop on Sellphy uses the same product page. What differs
                  is settings: theme, gallery, trust cards, whether the quantity
                  field shows, and what the button says. Variants can be size
                  pills, color swatches or a dropdown, depending on what the
                  shop sells.
                </p>
                <div>
                  <p data-motion="copy">
                    DEMO sells clothes, so the variants are sizes and colors and
                    the button says add to request. Alcona sells fence panels,
                    so the variant is a length dropdown and the button says add
                    to calculator. Gymleco sells gym equipment on a dark theme
                    with feature cards and a specs table.
                  </p>
                  <p data-motion="copy">
                    I wrote the page once. Each shop dresses it from the
                    dashboard.
                  </p>
                </div>
              </div>
            </section>

            <div class="sellphy-product-strip">
              <figure data-motion-group>
                <a
                  class="screen-window"
                  href={`${assets}/product-demo.webp`}
                  target="_blank"
                  rel="noreferrer"
                  aria-label="Open the DEMO product page screenshot at full size"
                  data-motion="cel"
                >
                  <div class="screen-bar" aria-hidden="true">
                    <span></span><span></span><span></span><b>DEMO / apparel</b>
                  </div>
                  <img
                    src={`${assets}/product-demo.webp`}
                    alt="DEMO shop product page for a white linen shirt with color and size choices, add to request, trust cards, and a specifications table"
                    width="1024"
                    height="710"
                    loading="lazy"
                  />
                </a>
                <figcaption>
                  <strong>DEMO</strong><span
                    >Sizes, colors, add to request. The demo shop; select to
                    enlarge.</span
                  >
                </figcaption>
              </figure>
              <figure data-motion-group>
                <a
                  class="screen-window"
                  href={`${assets}/product-alcona.webp`}
                  target="_blank"
                  rel="noreferrer"
                  aria-label="Open the Alcona product page screenshot at full size"
                  data-motion="cel"
                >
                  <div class="screen-bar" aria-hidden="true">
                    <span></span><span></span><span></span><b>Alcona / fences</b
                    >
                  </div>
                  <img
                    src={`${assets}/product-alcona.webp`}
                    alt="Alcona Solutions product page for a WPC fence panel with color swatches, a length dropdown, and an add to calculator button"
                    width="1024"
                    height="690"
                    loading="lazy"
                  />
                </a>
                <figcaption>
                  <strong>Alcona</strong><span
                    >Color swatches, a length dropdown, add to calculator.
                    Select to enlarge.</span
                  >
                </figcaption>
              </figure>
              <figure data-motion-group>
                <a
                  class="screen-window"
                  href={`${assets}/product-gymleco.webp`}
                  target="_blank"
                  rel="noreferrer"
                  aria-label="Open the Gymleco product page screenshot at full size"
                  data-motion="cel"
                >
                  <div class="screen-bar" aria-hidden="true">
                    <span></span><span></span><span></span><b
                      >Gymleco / equipment</b
                    >
                  </div>
                  <img
                    src={`${assets}/product-gymleco.webp`}
                    alt="Gymleco dark product page for an ISO lateral bench press with quantity, add to request, feature cards, and specifications"
                    width="1024"
                    height="681"
                    loading="lazy"
                  />
                </a>
                <figcaption>
                  <strong>Gymleco</strong><span
                    >Dark theme, feature cards, a specs table. Select to
                    enlarge.</span
                  >
                </figcaption>
              </figure>
            </div>

            <section class="case-section" id="dashboard" data-motion-group>
              <h2 data-motion="title">Where sellers spend the day.</h2>
              <div class="case-columns">
                <p class="case-lede" data-motion="copy">
                  Products, orders, inventory, promo codes, analytics, the site
                  editor, SEO tools and domains all live in one dashboard. It is
                  in Bulgarian, because that is the language the sellers work
                  in.
                </p>
                <div>
                  <p data-motion="copy">
                    The products screen is a table: thumbnail, status, price,
                    discount, variant count, sizes and categories, with filters
                    across the top. Ticking rows opens bulk edit.
                  </p>
                  <p data-motion="copy">
                    Page Preview takes any URL from the shop and shows what
                    Google, Facebook and X will display for it, with character
                    counts on the title and description. A title under 30
                    characters gets a warning. The audit table underneath lists
                    every field it checked.
                  </p>
                </div>
              </div>
            </section>

            <div class="case-proof-pair sellphy-catalog-pair">
              <figure data-motion-group>
                <a
                  class="screen-window"
                  href={`${assets}/products.webp`}
                  target="_blank"
                  rel="noreferrer"
                  aria-label="Open the Sellphy products screenshot at full size"
                  data-motion="cel"
                >
                  <div class="screen-bar" aria-hidden="true">
                    <span></span><span></span><span></span><b>Products</b>
                  </div>
                  <img
                    src={`${assets}/products.webp`}
                    alt="Sellphy products table with thumbnails, published status, euro prices, discounts, variant counts, and size pills"
                    width="1024"
                    height="658"
                    loading="lazy"
                  />
                </a>
                <figcaption>
                  <strong>The products table</strong><span
                    >Filters across the top, bulk edit through the checkboxes.
                    Demo shop; select to enlarge.</span
                  >
                </figcaption>
              </figure>
              <figure data-motion-group>
                <a
                  class="screen-window"
                  href={`${assets}/seo-preview.webp`}
                  target="_blank"
                  rel="noreferrer"
                  aria-label="Open the Sellphy page preview screenshot at full size"
                  data-motion="cel"
                >
                  <div class="screen-bar" aria-hidden="true">
                    <span></span><span></span><span></span><b>Page preview</b>
                  </div>
                  <img
                    src={`${assets}/seo-preview.webp`}
                    alt="Sellphy page preview tool showing a Google search snippet, Open Graph cards, and an audit table flagging a short title and description"
                    width="1024"
                    height="660"
                    loading="lazy"
                  />
                </a>
                <figcaption>
                  <strong>Page Preview</strong><span
                    >The Google snippet, the Open Graph cards and the audit
                    table for one category page. Demo shop; select to enlarge.</span
                  >
                </figcaption>
              </figure>
            </div>

            <figure class="case-screen" data-motion-group>
              <a
                class="screen-window"
                href={`${assets}/analytics.webp`}
                target="_blank"
                rel="noreferrer"
                aria-label="Open the Sellphy analytics dashboard screenshot at full size"
                data-motion="cel"
              >
                <div class="screen-bar" aria-hidden="true">
                  <span></span><span></span><span></span><b
                    >Analytics / demo data</b
                  >
                </div>
                <img
                  src={`${assets}/analytics.webp`}
                  alt="Sellphy analytics dashboard with page view, visitor, cart, and order totals above a visits chart and a top pages table"
                  width="1024"
                  height="659"
                  loading="lazy"
                />
              </a>
              <figcaption>
                <strong>Analytics without a cookie banner</strong><span
                  >Page views, unique visitors, add-to-carts and orders, then
                  the visits chart and the top pages. Visitors are counted
                  without cookies. The figures are demo data.</span
                >
              </figcaption>
            </figure>

            <section class="case-section" id="tours" data-motion-group>
              <h2 data-motion="title">Every screen explains itself.</h2>
              <div class="case-columns">
                <p class="case-lede" data-motion="copy">
                  Each main dashboard screen has a guided tour. It starts on the
                  first visit, and the question mark in the header replays it.
                  Completion is stored per shop. There are seventeen tours,
                  covering products, orders, the site editor, SEO, domains and
                  inventory.
                </p>
                <div>
                  <p data-motion="copy">
                    The analytics tour is ten steps. Step four, in the capture,
                    explains the visits chart: the dark line is total page
                    views, the light one is unique visitors per day. Because
                    there are no cookies, unique visitors reset at midnight UTC,
                    and someone who comes back every day for a week counts seven
                    times.
                  </p>
                  <p data-motion="copy">
                    That is the price of counting without cookies, and the tour
                    says so in plain words where the seller will read it.
                  </p>
                </div>
              </div>
            </section>

            <figure class="case-screen" data-motion-group>
              <a
                class="screen-window"
                href={`${assets}/analytics-tour.webp`}
                target="_blank"
                rel="noreferrer"
                aria-label="Open the Sellphy analytics tour screenshot at full size"
                data-motion="cel"
              >
                <div class="screen-bar" aria-hidden="true">
                  <span></span><span></span><span></span><b
                    >Analytics / tour step 4 of 10</b
                  >
                </div>
                <img
                  src={`${assets}/analytics-tour.webp`}
                  alt="Sellphy analytics page with a guided tour popup on step 4 of 10, explaining the visits chart"
                  width="1024"
                  height="662"
                  loading="lazy"
                />
              </a>
              <figcaption>
                <strong>Step 4 of 10</strong><span
                  >The tour names both lines on the chart before it moves on to
                  the tables below. Demo shop; select to enlarge.</span
                >
              </figcaption>
            </figure>

            <section class="case-section" id="static" data-motion-group>
              <h2 data-motion="title">Public pages are plain HTML.</h2>
              <div class="case-columns">
                <p class="case-lede" data-motion="copy">
                  The home, shop, category, about, services and legal pages are
                  rendered once and served as files. The first request builds
                  the page; every request after that gets the file, until the
                  seller saves a change. Then only the affected paths are
                  rebuilt.
                </p>
                <div>
                  <p data-motion="copy">
                    Cart, checkout and the dashboard stay dynamic. Category
                    filters would normally defeat the cache, so a proxy folds
                    the filter into an internal path while the public URL stays
                    readable. Redirects run in the same proxy, before a cached
                    page is served.
                  </p>
                  <p data-motion="copy">
                    Once the storefronts were static I no longer needed Vercel.
                    The whole platform now runs in Docker on a Hetzner VPS
                    behind Caddy, and the hosting bill is 83% lower. Moving all
                    of my own shops onto it saves me 25 or more hours of
                    maintenance a month.
                  </p>
                </div>
              </div>
            </section>

            <section class="case-next" data-motion-group>
              <div>
                <h2 data-motion="title">
                  Next up:<br /><span class="title-outline">Finance Me.</span>
                </h2>
                <p data-motion="copy">
                  A family expense tracker that picks up Apple Pay purchases
                  through an iOS Shortcut.
                </p>
              </div>
              <a
                class="button button-light"
                href="/work/finance-me"
                data-squash
                data-motion="action">View Finance Me <ArrowIcon /></a
              >
            </section>
          </div>
        </div>
      </article>
    </main>
  </div>
</BaseLayout>

<style>
  .sellphy-hero {
    grid-template-columns: minmax(19rem, 0.72fr) minmax(0, 1.28fr);
  }

  .sellphy-stage {
    min-width: 0;
  }
  .sellphy-stage figcaption {
    margin-top: 1rem;
    font-size: 1rem;
    line-height: 1.4;
  }
  .sellphy-stage figcaption span {
    display: block;
    color: #55534c;
  }
  .sellphy-case .screen-window > img {
    aspect-ratio: auto;
    height: auto;
    filter: none;
  }
  .sellphy-case .screen-window {
    border-color: #77736a;
  }
  .sellphy-stage .screen-window {
    border-color: var(--ink);
  }

  .setup-sequence {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin-top: 3rem;
    padding: 0;
    list-style: none;
    border-block: 2px solid var(--paper-light);
  }

  .setup-sequence li {
    padding: 1.5rem 1rem;
  }
  .setup-sequence li + li {
    border-left: 1px solid #77736a;
  }
  .setup-sequence li:nth-child(4) {
    border-left: 0;
  }
  .setup-sequence li:nth-child(n + 4) {
    border-top: 1px solid #77736a;
  }
  .setup-sequence strong {
    display: block;
    font: 600 1.1rem var(--font-display);
  }
  .setup-sequence span {
    display: block;
    margin-top: 0.4rem;
    color: var(--smoke-light);
  }
  .sellphy-product-strip {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    padding: clamp(2rem, 5vw, 4rem) 0 clamp(4rem, 8vw, 8rem);
    border-bottom: 1px solid #4a4943;
  }
  .sellphy-product-strip figcaption {
    display: grid;
    gap: 0.35rem;
    padding: 0.9rem 0.15rem 0;
    color: var(--smoke-light);
  }
  .sellphy-product-strip figcaption strong {
    color: var(--paper-light);
    font-family: var(--font-display);
    font-size: 1.05rem;
  }

  .sellphy-catalog-pair {
    grid-template-columns: 1fr;
    gap: 3rem;
  }
  .sellphy-catalog-pair figure:nth-child(2) {
    padding-top: 0;
  }
  .sellphy-catalog-pair figcaption {
    grid-template-columns: 0.35fr 0.65fr;
    gap: 2rem;
  }

  @media (max-width: 1100px) {
    .sellphy-hero {
      grid-template-columns: 1fr;
    }
    .sellphy-hero .case-meta {
      margin-top: 0;
    }
    .sellphy-stage {
      max-width: 58rem;
    }
    .sellphy-product-strip {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }

  @media (max-width: 700px) {
    .sellphy-catalog-pair figcaption {
      grid-template-columns: 1fr;
      gap: 0.45rem;
    }
    .setup-sequence {
      grid-template-columns: 1fr;
    }
    .setup-sequence li {
      padding-inline: 0;
    }
    .setup-sequence li + li,
    .setup-sequence li:nth-child(4) {
      border-left: 0;
    }
    .setup-sequence li + li,
    .setup-sequence li:nth-child(n + 4) {
      border-top: 1px solid #77736a;
    }
    .sellphy-stage figcaption {
      font-size: 0.95rem;
    }
  }
</style>
