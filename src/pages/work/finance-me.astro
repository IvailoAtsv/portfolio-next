---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StudioNav from '../../components/StudioNav.astro';
import ArrowIcon from '../../components/ArrowIcon.astro';
import FilmStatic from '../../components/FilmStatic.astro';
import { pages } from '../../lib/site';

const paymentSteps = [
  {
    title: 'Pay with Apple Pay',
    detail: 'The Wallet transaction supplies the amount, merchant and date.',
  },
  {
    title: 'Run the Shortcut',
    detail: 'A personal automation sends those fields to the import URL.',
  },
  {
    title: 'Check and classify',
    detail: 'Validate the payload, pick a category and check for a duplicate.',
  },
  {
    title: 'Add to the ledger',
    detail: 'Save the expense in the member’s family, or their own history.',
  },
];
---

<BaseLayout page={pages.financeMe}>
  <div class="site-shell case-shell finance-case">
    <StudioNav />
    <main id="main-content">
      <article class="case-study">
        <header class="case-hero" data-motion-group>
          <div class="case-heading">
            <a class="pill-link back-link" href="/#work">
              <ArrowIcon direction="left" /> Back to the reel
            </a>
            <h1 class="hero-title" data-motion="title">
              <span class="title-line"><span>Finance</span></span>
              <span class="title-line title-outline"><span>Me.</span></span>
            </h1>
            <p data-motion="copy">
              Finance Me is a family expense tracker I designed and built. After
              an Apple Pay purchase, an iOS Shortcut can send the amount,
              merchant and date into the app, where it lands as a categorized
              expense the household can see.
            </p>
            <div class="case-actions" data-motion="action">
              <a class="button button-dark" href="#capture" data-squash>
                Follow a payment <ArrowIcon direction="down" />
              </a>
            </div>
          </div>
          <div class="hero-stage case-stage" data-loop data-motion="cel">
            <div class="hero-cel has-film">
              <img
                src="/assets/generated/finance-me-savings.webp"
                alt="A cheerful wallet character puts a coin into a household savings jar beside an open ledger"
                width="1400"
                height="1120"
                fetchpriority="high"
              />
              <FilmStatic />
            </div>
            <div class="stage-sign stage-sign-green" aria-hidden="true">
              <span>A little today.</span><span>A plan for tomorrow.</span>
            </div>
          </div>
          <dl class="case-meta">
            <div data-motion="detail">
              <dt>Role</dt><dd>Product design<br />Full-stack development</dd>
            </div>
            <div data-motion="detail">
              <dt>Product</dt><dd>Family finance<br />Mobile-first web app</dd>
            </div>
            <div data-motion="detail">
              <dt>Integration</dt><dd>Apple Wallet<br />iOS Shortcuts</dd>
            </div>
            <div data-motion="detail">
              <dt>System</dt><dd>
                Next.js · TypeScript<br />MongoDB · NextAuth
              </dd>
            </div>
          </dl>
        </header>

        <div class="wave-divider case-wave" data-loop aria-hidden="true">
          <svg viewBox="0 0 2880 96" preserveAspectRatio="none">
            <path
              d="M0 51c80-42 160 42 240 0s160 42 240 0s160 42 240 0s160 42 240 0s160 42 240 0s160 42 240 0s160 42 240 0s160 42 240 0s160 42 240 0s160 42 240 0s160 42 240 0s160 42 240 0v80H0Z"
            ></path>
          </svg>
        </div>

        <div class="case-body">
          <nav class="case-nav" aria-label="Case study sections">
            <span>On this reel</span>
            <a href="#capture">Apple Pay import</a>
            <a href="#classification">Merchant and category</a>
            <a href="#family">Shared household</a>
            <a href="#goals">Savings goals</a>
          </nav>

          <div class="case-content">
            <section
              class="case-section case-opening"
              id="capture"
              data-motion-group
            >
              <h2 data-motion="title">Catch the purchase as it happens.</h2>
              <div class="case-columns">
                <p class="case-lede" data-motion="copy">
                  A household budget only works if the small payments actually
                  get recorded. Forget a few of them and the shared ledger is
                  useless. I designed Finance Me around that moment: capture the
                  purchase, then give the family one place to look at it.
                </p>
                <div>
                  <p data-motion="copy">
                    After setup, a Wallet transaction can become a recorded
                    expense with the merchant, category and tags already
                    attached. An iOS Shortcut picks up the Wallet fields and
                    posts them to the app’s import endpoint.
                  </p>
                  <p data-motion="copy">
                    The workflow below is how the import works, drawn from the
                    source. It uses example data; it is not a recording of the
                    app.
                  </p>
                </div>
              </div>
              <figure class="payment-flow" data-motion="detail">
                <ol>
                  {
                    paymentSteps.map((step, index) => (
                      <li>
                        <span class="flow-stop" aria-hidden="true">
                          {index + 1}
                        </span>
                        <strong>{step.title}</strong>
                        <p>{step.detail}</p>
                        {index < paymentSteps.length - 1 && <ArrowIcon />}
                      </li>
                    ))
                  }
                </ol>
                <figcaption>
                  One payment, from the checkout to the family’s records.
                </figcaption>
              </figure>
            </section>

            <section class="case-section" id="classification" data-motion-group>
              <h2 data-motion="title">Keep the merchant. Add the category.</h2>
              <div class="case-columns">
                <p class="case-lede" data-motion="copy">
                  “Groceries” says what the money was for. “Lidl Sofia” says
                  where it went. The import keeps both, so monthly totals do not
                  wipe out the detail you need to understand a month of
                  spending.
                </p>
                <div>
                  <p data-motion="copy">
                    Merchant rules suggest a category; an unrecognized merchant
                    falls back to other expenses. Amount parsing accepts comma
                    decimals and currency labels from Shortcuts, so a payload
                    that looks like “12,50 EUR” still lands as 12.50.
                  </p>
                </div>
              </div>
              <figure
                class="import-example"
                data-finance-example
                data-motion="detail"
              >
                <div class="import-input">
                  <label for="example-merchant">Try an example merchant</label>
                  <select id="example-merchant" name="example-merchant">
                    <option value="lidl">Lidl Sofia</option>
                    <option value="starbucks">Starbucks</option>
                    <option value="bookshop">Local bookshop</option>
                  </select>
                  <p>Merchant name from Wallet</p>
                  <ArrowIcon />
                </div>
                <div
                  class="import-output"
                  aria-live="polite"
                  aria-atomic="true"
                >
                  <span>Recorded as</span>
                  <strong data-import-category>Groceries</strong>
                  <dl>
                    <div>
                      <dt>Merchant tag</dt><dd data-import-merchant>
                        Lidl Sofia
                      </dd>
                    </div>
                    <div><dt>Source tag</dt><dd>apple-pay</dd></div>
                  </dl>
                </div>
                <figcaption>
                  Interactive example of the category rules in the import.
                </figcaption>
              </figure>
              <div class="finance-decision" data-motion-group>
                <h3 data-motion="title">
                  A retry should not become a second expense.
                </h3>
                <p data-motion="copy">
                  The import fingerprints the user, the amount, the normalized
                  merchant and the transaction minute. A uniqueness rule in the
                  database catches a repeated payload and returns success
                  without another row. Matching to the minute is a retry
                  safeguard, not a bank-issued transaction identifier.
                </p>
              </div>
            </section>

            <section class="case-section" id="family" data-motion-group>
              <h2 data-motion="title">One household, one ledger.</h2>
              <div
                class="family-scope"
                data-motion="detail"
                role="img"
                aria-label="Two family members contribute transactions to one family history. The history supplies category breakdowns, merchant detail and CSV export."
              >
                <div class="family-contributors" aria-hidden="true">
                  <span>Family member</span>
                  <span>Family member</span>
                </div>
                <div class="family-junction" aria-hidden="true">
                  <ArrowIcon />
                </div>
                <div class="family-ledger" aria-hidden="true">
                  <strong>Shared history</strong>
                  <span>Who added it · What it was for · Where it went</span>
                </div>
                <div class="family-outputs" aria-hidden="true">
                  <span>Category breakdowns</span><span>Merchant detail</span
                  ><span>CSV export</span>
                </div>
              </div>
              <div class="case-columns">
                <p class="case-lede" data-motion="copy">
                  Joining a family changes whose records you see. Members look
                  at the family’s transaction pool, and new manual entries and
                  Wallet imports belong to that family. Each transaction still
                  carries its creator, so individual contributions stay visible.
                </p>
                <div>
                  <p data-motion="copy">
                    That boundary is enforced in the server queries and in the
                    access checks on each transaction. Solo users work with
                    their own records. Family invitations check the recipient’s
                    email and the expiry date before granting membership.
                  </p>
                  <p data-motion="copy">
                    Coming back to the app refreshes the list, so a change from
                    another phone shows up. It is a check-in, not a live
                    dashboard that has to stay open.
                  </p>
                </div>
              </div>
            </section>

            <section class="case-section" id="goals" data-motion-group>
              <h2 data-motion="title">Give the next euro a destination.</h2>
              <div
                class="goal-horizons"
                aria-label="Savings goal time horizons"
                data-motion="detail"
              >
                <div><strong>0–3</strong><span>years</span></div>
                <div><strong>3–10</strong><span>years</span></div>
                <div><strong>10+</strong><span>years</span></div>
              </div>
              <div class="case-columns">
                <p class="case-lede" data-motion="copy">
                  Shared goals group saving by how far away it is: under three
                  years, three to ten, or ten and up. Each goal has a balance,
                  an optional target and a contribution history, so progress
                  traces back to actual entries.
                </p>
                <div>
                  <p data-motion="copy">
                    Contributions record the member, the amount and an optional
                    note. If someone has not joined a family yet, the goals page
                    says so and links to family setup. Even the empty state has
                    a job: show the next useful action.
                  </p>
                </div>
              </div>
            </section>

            <section class="case-next" data-motion-group>
              <div>
                <h2 data-motion="title">Next on the reel: HLP Labs.</h2>
                <p data-motion="copy">
                  A Bulgarian shop for research peptides, with a reference
                  library and the admin panel behind it.
                </p>
              </div>
              <a
                class="button button-light"
                href="/work/hlp-labs"
                data-squash
                data-motion="action"
              >
                View HLP Labs <ArrowIcon />
              </a>
            </section>
          </div>
        </div>
      </article>
    </main>
  </div>
</BaseLayout>

<style>
  .finance-case .stage-sign {
    display: grid;
    gap: 0.2rem;
    background: var(--green);
    color: var(--paper-light);
  }
  .payment-flow {
    margin-top: 3.5rem;
  }
  .payment-flow ol {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .payment-flow li {
    position: relative;
    padding-top: 1.5rem;
    border-top: 2px solid var(--paper-light);
  }
  .flow-stop {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    margin-bottom: 1.6rem;
    border: 2px solid var(--paper-light);
    border-radius: 50%;
    font-family: var(--font-display);
  }
  .payment-flow strong {
    display: block;
    max-width: 12ch;
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2vw, 1.65rem);
    font-weight: 550;
    line-height: 1.2;
  }
  .payment-flow li > p {
    margin-top: 1rem;
    color: var(--smoke-light);
    font-size: 1rem;
    line-height: 1.45;
  }
  .payment-flow li > :global(svg) {
    position: absolute;
    top: 2.1rem;
    right: 0;
    width: 1.5rem;
  }
  .payment-flow figcaption,
  .import-example figcaption {
    margin-top: 1.4rem;
    color: var(--smoke-light);
    font-size: 0.95rem;
  }
  .import-example {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    margin-top: 3.5rem;
    border: 2px solid var(--paper-light);
    border-radius: 14px;
    overflow: hidden;
  }
  .import-input {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 2.2rem clamp(1.3rem, 3vw, 2.7rem);
    background: var(--paper);
    color: var(--ink);
  }
  .import-input label,
  .import-output > span {
    font-family: var(--font-display);
    font-size: 1rem;
  }
  .import-input select {
    width: 100%;
    min-height: 3.4rem;
    margin-top: 1rem;
    padding: 0.7rem 1.5rem 0.7rem 0.8rem;
    border: 2px solid var(--ink);
    border-radius: 8px;
    color: var(--ink);
    background-color: var(--paper-light);
    font: inherit;
    font-size: 1.25rem;
    cursor: pointer;
  }
  .import-input select:focus-visible {
    outline: 3px solid var(--ink);
    outline-offset: 4px;
  }
  .import-input > p {
    margin-top: 0.7rem;
    font-size: 1rem;
  }
  .import-input > :global(svg) {
    align-self: end;
    width: 2rem;
    height: 2rem;
    margin-top: 1rem;
  }
  .import-output {
    padding: 2.2rem clamp(1.3rem, 3vw, 2.7rem);
  }
  .import-output > strong {
    display: block;
    margin: 0.9rem 0 1.8rem;
    color: var(--yellow);
    font-family: var(--font-display);
    font-size: clamp(2rem, 3vw, 3rem);
    font-weight: 550;
    line-height: 1.1;
  }
  .import-output dl {
    margin: 0;
  }
  .import-output dl > div {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    padding: 0.6rem 0;
    border-top: 1px solid #4a4943;
  }
  .import-output dt {
    color: var(--smoke-light);
  }
  .import-output dd {
    margin: 0;
    text-align: end;
    overflow-wrap: anywhere;
  }
  .import-example figcaption {
    grid-column: 1 / -1;
    margin: 0;
    padding: 0.85rem 1.3rem;
    border-top: 1px solid #4a4943;
  }
  .finance-decision {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    margin-top: 3.5rem;
  }
  .finance-decision h3 {
    max-width: 19ch;
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 2.4vw, 2.25rem);
    font-weight: 500;
    line-height: 1.2;
  }
  .finance-decision p {
    color: var(--smoke-light);
  }
  .family-scope {
    display: grid;
    grid-template-columns: 1fr 3.5rem 1.6fr;
    align-items: center;
    margin-top: 3.5rem;
    padding: clamp(1.4rem, 3vw, 2.5rem);
    border: 2px solid var(--paper-light);
    border-radius: 14px;
  }
  .family-contributors {
    display: grid;
    gap: 1.5rem;
  }
  .family-contributors > span {
    padding: 0.8rem;
    border: 1px solid var(--paper-light);
    border-radius: 6px;
    font-family: var(--font-display);
    text-align: center;
  }
  .family-junction {
    display: flex;
    justify-content: center;
  }
  .family-junction :global(svg) {
    width: 1.5rem;
  }
  .family-ledger {
    align-self: stretch;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.8rem;
    padding: 1.3rem;
    border-radius: 8px;
    background: var(--yellow);
    color: var(--ink);
  }
  .family-ledger strong {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3vw, 2.7rem);
    font-weight: 550;
    line-height: 1.1;
  }
  .family-ledger > span {
    max-width: 26ch;
    line-height: 1.35;
  }
  .family-outputs {
    grid-column: 1 / -1;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1.8rem;
    padding-top: 1.2rem;
    border-top: 1px solid #75736b;
    font-size: 1.05rem;
  }
  .goal-horizons {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin-top: 3.5rem;
    border-top: 2px solid var(--paper-light);
    border-bottom: 2px solid var(--paper-light);
  }
  .goal-horizons > div {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.6rem 1rem;
  }
  .goal-horizons > div + div {
    border-left: 1px solid #75736b;
  }
  .goal-horizons strong {
    color: var(--yellow);
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 4.3vw, 4.5rem);
    font-weight: 500;
    line-height: 1;
  }
  .goal-horizons span {
    font-size: 1.2rem;
  }

  @media (max-width: 1100px) {
    .payment-flow ol {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2rem;
    }
    .payment-flow strong {
      max-width: none;
    }
    .payment-flow li:nth-child(2) > :global(svg) {
      transform: rotate(90deg);
    }
  }
  @media (max-width: 640px) {
    .import-example,
    .finance-decision {
      grid-template-columns: 1fr;
    }
    .import-input > :global(svg) {
      align-self: center;
      transform: rotate(90deg);
    }
    .finance-decision h3 {
      max-width: 23ch;
    }
    .family-scope {
      grid-template-columns: 1fr;
    }
    .family-contributors {
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
    }
    .family-junction {
      padding: 1rem;
    }
    .family-junction :global(svg) {
      transform: rotate(90deg);
    }
    .family-ledger {
      text-align: center;
      align-items: center;
      padding: 1.6rem 1rem;
    }
    .family-outputs {
      flex-wrap: wrap;
      justify-content: center;
      column-gap: 1.3rem;
      text-align: center;
      font-size: 0.95rem;
    }
    .goal-horizons > div {
      padding: 1.4rem 0.7rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .finance-case :global([data-motion]) {
      transform: none;
    }
  }
</style>

<script>
  function initializeFinanceExample() {
    const example = document.querySelector<HTMLElement>(
      '[data-finance-example]',
    );
    if (!example || example.dataset.initialized) return;
    const select = example.querySelector<HTMLSelectElement>('select');
    const category = example.querySelector<HTMLElement>(
      '[data-import-category]',
    );
    const merchant = example.querySelector<HTMLElement>(
      '[data-import-merchant]',
    );
    if (!select || !category || !merchant) return;
    example.dataset.initialized = 'true';

    const examples: Record<string, { category: string; merchant: string }> = {
      lidl: { category: 'Groceries', merchant: 'Lidl Sofia' },
      starbucks: { category: 'Coffee', merchant: 'Starbucks' },
      bookshop: { category: 'Other expenses', merchant: 'Local bookshop' },
    };

    const update = () => {
      const selected = examples[select.value];
      if (!selected) return;
      category.textContent = selected.category;
      merchant.textContent = selected.merchant;
    };
    select.addEventListener('change', update);
    update();
  }

  initializeFinanceExample();
  document.addEventListener('astro:page-load', initializeFinanceExample);
</script>
