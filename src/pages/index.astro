---
import BaseLayout from '../layouts/BaseLayout.astro';
import StudioNav from '../components/StudioNav.astro';
import ArrowIcon from '../components/ArrowIcon.astro';
import FilmStatic from '../components/FilmStatic.astro';
import CircleWords from '../components/CircleWords.astro';

const projects = [
  {
    title: 'HLP Labs',
    image: '/assets/generated/hlp-lab-scene-v2.webp',
    alt: 'A friendly vial character points at a microscope slide beside a laboratory specimen cabinet',
    description:
      'A technical catalog made understandable for customers and manageable for the people running it.',
    disciplines: ['Product UX', 'Full-stack', 'Operations'],
    tone: 'smoke',
    stamp: ['FIND', 'LEARN', 'OPERATE'],
    href: '/work/hlp-labs',
    width: 1400,
    height: 1000,
  },
  {
    title: 'Keep Up',
    image: '/assets/generated/keep-up-scene-v2.webp',
    alt: 'A smiling flashcard character runs along a track holding a daily calendar',
    description:
      'An offline-capable learning PWA built around daily programming quizzes, spaced repetition, and visible progress.',
    disciplines: ['Product UX', 'PWA engineering', 'Offline systems'],
    tone: 'yellow',
    stamp: ['LEARN', 'RECALL', 'REPEAT'],
    width: 1400,
    height: 1120,
  },
  {
    title: 'Sellphy',
    image: '/assets/generated/sellphy-shop.webp',
    alt: 'A browser-window shopkeeper with a striped awning carefully seals a parcel at a packing table',
    description:
      'A multi-tenant platform for creating and operating online shops, public websites, products, content, and orders.',
    disciplines: ['Platform design', 'Full-stack', 'Commerce systems'],
    tone: 'red',
    stamp: ['BUILD', 'SELL', 'OPERATE'],
    width: 1400,
    height: 1120,
  },
  {
    title: 'Finance Me',
    image: '/assets/generated/finance-me-savings.webp',
    alt: 'A wallet character puts a coin into a household savings jar beside an open budget ledger',
    description:
      'A mobile-first family finance product for shared transactions, goals, recurring activity, analytics, and exports.',
    disciplines: ['Mobile UX', 'PWA engineering', 'Data workflows'],
    tone: 'smoke',
    stamp: ['TRACK', 'PLAN', 'SHARE'],
    width: 1400,
    height: 1120,
  },
];

const practiceBeats = [
  {
    title: 'Shape the experience',
    copy: 'Find the real problem, simplify the journey, and give the product a visual point of view.',
  },
  {
    title: 'Build the system',
    copy: 'Translate the experience into durable interfaces, data models, workflows, and operational tools.',
  },
  {
    title: 'Ship the real thing',
    copy: 'Test the edges, tune the details, and stay accountable to what people actually use.',
  },
];
---

<BaseLayout>
  <div class="site-shell">
    <StudioNav home />

    <main id="main-content">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <h1 id="hero-title" class="hero-title">
            <span class="title-line">
              <span class="pop" style="--i: 0">I make</span>
              <span class="pop title-outline" style="--i: 1">digital</span>
            </span>
            <span class="title-line">
              <span class="pop title-outline" style="--i: 2">products</span>
              <span class="pop" style="--i: 3">sing.</span>
            </span>
          </h1>
          <p class="fade-up" style="--i: 0">
            I’m Ivaylo, a product-minded full-stack developer who designs the
            experience, builds the system, and stays until the real thing works.
          </p>
          <div class="hero-actions fade-up" style="--i: 1">
            <a class="button button-dark" href="/work/hlp-labs" data-squash>
              See HLP Labs <ArrowIcon />
            </a>
            <a class="button button-paper" href="#work" data-squash>
              Browse the reel
            </a>
          </div>
          <ul
            class="proof-seals fade-up"
            style="--i: 2"
            aria-label="Core strengths"
          >
            <li>
              <svg viewBox="0 0 32 32" aria-hidden="true">
                <path
                  d="M3 16c4-6.2 8.3-9.2 13-9.2S25 9.8 29 16c-4 6.2-8.3 9.2-13 9.2S7 22.2 3 16Z"
                ></path>
                <circle cx="16" cy="16" r="4.4"></circle>
                <circle class="ink" cx="17.4" cy="14.6" r="1.1"></circle>
              </svg>
              Product judgment
            </li>
            <li>
              <svg viewBox="0 0 32 32" aria-hidden="true">
                <rect x="7" y="4.5" width="18" height="7" rx="2"></rect>
                <rect x="10" y="12.5" width="18" height="7" rx="2"></rect>
                <rect x="5" y="20.5" width="18" height="7" rx="2"></rect>
              </svg>
              Full-stack depth
            </li>
            <li>
              <svg viewBox="0 0 32 32" aria-hidden="true">
                <rect x="4.5" y="9.5" width="23" height="18" rx="2.5"></rect>
                <path d="M4.5 15.5h23M16 9.5v6M11 5.5h10l2 4H9z"></path>
                <path d="m12 21.5 2.6 2.6 5.4-5.6"></path>
              </svg>
              Shipped craft
            </li>
          </ul>
        </div>

        <div class="hero-stage" data-loop>
          <div class="hero-cel cel-enter has-film">
            <img
              src="/assets/generated/hero-browser.webp"
              alt="A browser-window character sings into a vintage microphone on a small wooden stage"
              width="1536"
              height="1024"
              fetchpriority="high"
            />
            <FilmStatic />
          </div>
          <div class="stage-notes" aria-hidden="true">
            {
              Array.from({ length: 8 }, (_, index) => (
                <svg
                  class="stage-note"
                  viewBox={index % 4 === 1 ? '0 0 40 40' : '0 0 28 40'}
                  focusable="false"
                >
                  {index % 4 === 1 ? (
                    <>
                      <path d="M14 8v24M32 5v24" />
                      <ellipse
                        cx="9"
                        cy="32.5"
                        rx="5.6"
                        ry="4"
                        transform="rotate(-18 9 32.5)"
                      />
                      <ellipse
                        cx="27"
                        cy="29.5"
                        rx="5.6"
                        ry="4"
                        transform="rotate(-18 27 29.5)"
                      />
                      <path d="M14 8 32 5M14 14l18-3" />
                    </>
                  ) : (
                    <>
                      <path d="M15 5v26" />
                      <ellipse
                        cx="10"
                        cy="31.5"
                        rx="6"
                        ry="4.2"
                        transform="rotate(-18 10 31.5)"
                      />
                      {index % 4 !== 2 && <path d="M15 5c6 1.5 9 5 9.5 10.5" />}
                      {index % 4 === 3 && (
                        <path d="M15 12c5 1.5 7.5 4.5 8 8.5" />
                      )}
                    </>
                  )}
                </svg>
              ))
            }
          </div>
          <div class="stage-sign" aria-hidden="true">
            <span>Design</span>
            <i><span>+</span></i>
            <span>Code</span>
          </div>
        </div>

        <a class="scroll-cue fade-up" style="--i: 3" href="#work">
          <span>Roll the reel</span>
          <ArrowIcon direction="down" />
        </a>
      </section>

      <div class="wave-divider wave-hero" data-loop aria-hidden="true">
        <svg viewBox="0 0 2880 96" preserveAspectRatio="none">
          <path
            d="M0 51c80-42 160 42 240 0s160 42 240 0s160 42 240 0s160 42 240 0s160 42 240 0s160 42 240 0s160 42 240 0s160 42 240 0s160 42 240 0s160 42 240 0s160 42 240 0s160 42 240 0v80H0Z"
          ></path>
        </svg>
      </div>

      <section class="work-section" id="work" aria-labelledby="work-title">
        <div class="section-intro" data-reveal>
          <h2 id="work-title">
            <span class="title-line">The work,</span>
            <span class="title-line title-outline">opened up.</span>
          </h2>
          <p>
            Real interfaces in front. Product decisions and systems behind them.
            No mystery box, no tech-list theatre.
          </p>
        </div>

        <div class="project-reel" aria-label="Selected projects">
          {
            projects.map((project, index) => (
              <article
                class:list={['reel-project', `tone-${project.tone}`]}
                data-reveal
              >
                <div class="reel-stage" data-loop>
                  <div class="reel-scene has-film">
                    <img
                      src={project.image}
                      alt={project.alt}
                      width={project.width}
                      height={project.height}
                      loading="lazy"
                    />
                    <FilmStatic />
                  </div>
                  <span class="reel-seal" aria-hidden="true">
                    <CircleWords
                      id={`seal-ring-${index}`}
                      words={project.stamp}
                      separator="·"
                      radius={43}
                      size={120}
                    >
                      <circle
                        class="seal-disc"
                        slot="back"
                        cx="60"
                        cy="60"
                        r="58"
                      />
                      <circle class="seal-dot" cx="60" cy="60" r="5" />
                    </CircleWords>
                  </span>
                </div>
                <div class="reel-copy">
                  <h3>{project.title}</h3>
                  <p>{project.description}</p>
                  <ul>
                    {project.disciplines.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                  <span class="case-status">
                    Case study in the cutting room
                  </span>
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <section
        class="practice-section"
        id="practice"
        aria-labelledby="practice-title"
      >
        <div class="practice-inner">
          <h2 id="practice-title" data-reveal>
            <span class="title-line">One practice.</span>
            <span class="title-line title-outline">All the way through.</span>
          </h2>

          <figure class="practice-stage" data-reveal data-loop>
            <div class="practice-frame has-film">
              <div class="film-strip film-strip-top" aria-hidden="true">
                <span class="film-sprockets"></span>
              </div>
              <img
                src="/assets/generated/practice-conveyor.webp"
                alt="One conveyor belt runs through three stations: a drafting table sketching a screen, a machine with a wrench tightening it, and a crate rolling into a delivery truck"
                width="1536"
                height="1024"
                loading="lazy"
              />
              <FilmStatic />
              <div class="film-strip film-strip-bottom" aria-hidden="true">
                <span class="film-sprockets"></span>
              </div>
            </div>
          </figure>

          <ol class="practice-track">
            {
              practiceBeats.map((beat, index) => (
                <li class="practice-beat" data-reveal style={`--i: ${index}`}>
                  <h3>{beat.title}</h3>
                  <p>{beat.copy}</p>
                </li>
              ))
            }
          </ol>
        </div>
      </section>

      <section class="about-section" id="about" aria-labelledby="about-title">
        <div class="about-portrait" data-reveal data-loop>
          <div class="portrait-disc has-film">
            <img
              src="/assets/generated/different-hats-browser.webp"
              alt="A browser-window character tips a designer's beret while holding a builder's hard hat"
              width="1024"
              height="1024"
              loading="lazy"
            />
            <FilmStatic />
          </div>
          <CircleWords
            id="name-curve"
            class="portrait-ring"
            words={['DESIGNER', 'DEVELOPER', 'MAKER']}
            repeats={2}
            radius={172}
            size={400}
          />
        </div>
        <div class="about-copy" data-reveal>
          <h2 id="about-title">
            <span class="title-line">Different hats.</span>
            <span class="title-line title-outline">Same head.</span>
          </h2>
          <p class="about-lede">
            I work where product design and software engineering meet. That
            means fewer handoffs, clearer decisions, and a stronger line from
            the first sketch to the shipped system.
          </p>
          <p>
            I’m based in Bulgaria and currently work as a full-stack developer
            at Vention, alongside independent product work. I care about useful
            complexity: making sophisticated products feel direct without
            pretending the hard parts are simple.
          </p>
          <div class="about-links">
            <a
              class="pill-link"
              href="https://github.com/IvailoAtsv"
              target="_blank"
              rel="noreferrer">GitHub <ArrowIcon direction="external" /></a
            >
            <a
              class="pill-link"
              href="https://www.linkedin.com/in/ivaylo-atanasov-7aa413268"
              target="_blank"
              rel="noreferrer">LinkedIn <ArrowIcon direction="external" /></a
            >
          </div>
        </div>
      </section>

      <section
        class="contact-section"
        id="contact"
        aria-labelledby="contact-title"
      >
        <div class="contact-copy" data-reveal>
          <h2 id="contact-title">
            <span class="title-line">Got a hard product</span>
            <span class="title-line title-outline">worth making?</span>
          </h2>
          <p>
            If you’re building a team that values product thinking and
            engineering craft in the same person, I’d like to hear what you’re
            working on.
          </p>
          <a
            class="button button-dark button-large"
            href="mailto:ivailoatanassov@gmail.com"
            data-squash
          >
            ivailoatanassov@gmail.com <ArrowIcon />
          </a>
        </div>
        <div class="contact-stage" data-reveal data-loop>
          <img
            class="contact-hand"
            src="/assets/generated/contact-hand.webp"
            alt="A white-gloved hand offers an open envelope with a blank card inside"
            width="1050"
            height="835"
            loading="lazy"
          />
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <a
        class="studio-mark studio-mark-inverse"
        href="#top"
        aria-label="Back to the top"
        data-squash
      >
        <svg viewBox="0 0 58 58" aria-hidden="true"
          ><path
            class="mark-disc"
            d="M29 3C44 3 55 14 55 29S44 55 29 55 3 44 3 29 14 3 29 3Z"
          ></path><path
            class="mark-eye"
            d="M18 21c3-4 7-2 7 3 0 4-2 7-5 7s-5-6-2-10Zm17-1c4-3 7 0 6 5 0 4-3 7-6 6-3-2-3-8 0-11Z"
          ></path><path class="mark-smile" d="M17 36c7 8 18 9 26-1"></path></svg
        >
        <span><strong>IVAYLO</strong><small>DOES IT ALL</small></span>
      </a>
      <p>
        Designed and built in Bulgaria.<br />Astro, Tailwind, and a lot of ink.
      </p>
      <p class="footer-signoff">That’s all, folks.</p>
    </footer>
  </div>
</BaseLayout>
