---
import BaseLayout from '../layouts/BaseLayout.astro';
import StudioNav from '../components/StudioNav.astro';
import ArrowIcon from '../components/ArrowIcon.astro';
import FilmStatic from '../components/FilmStatic.astro';
import CircleWords from '../components/CircleWords.astro';
import { pages } from '../lib/site';
import practiceConveyor from '../assets/practice-conveyor.webp';

const projects = [
  {
    title: 'HLP Labs',
    image: '/assets/generated/hlp-lab-scene-v2.webp',
    alt: 'A friendly vial character points at a microscope slide beside a laboratory specimen cabinet',
    description:
      'A Bulgarian shop for research peptides, with a reference library for customers and an admin panel for the catalog, articles and orders.',
    disciplines: ['Product design', 'Full-stack development', 'Admin tools'],
    tone: 'smoke',
    stamp: ['FIND', 'LEARN', 'OPERATE'],
    href: '/work/hlp-labs',
    width: 1400,
    height: 1000,
  },
  {
    title: 'Keep Up',
    image: '/assets/generated/keep-up-scene-v2.webp',
    alt: 'A smiling flashcard character runs along a track holding a daily calendar',
    description:
      'A daily programming quiz and learning paths on your phone. The app still works without a connection. A pixel-art duck reacts when you answer.',
    disciplines: ['App design', 'Web app development', 'Offline support'],
    tone: 'yellow',
    stamp: ['LEARN', 'RECALL', 'REPEAT'],
    href: '/work/keep-up',
    width: 1400,
    height: 1120,
  },
  {
    title: 'Sellphy',
    image: '/assets/generated/sellphy-shop.webp',
    alt: 'A browser-window shopkeeper with a striped awning carefully seals a parcel at a packing table',
    description:
      'A shop platform. Public pages are static HTML. Each shop dresses the same product page. Every main dashboard screen has a tour.',
    disciplines: ['Platform design', 'Full-stack development', 'E-commerce'],
    tone: 'red',
    stamp: ['BUILD', 'SELL', 'OPERATE'],
    href: '/work/sellphy',
    width: 1400,
    height: 1120,
  },
  {
    title: 'Finance Me',
    image: '/assets/generated/finance-me-savings.webp',
    alt: 'A wallet character puts a coin into a household savings jar beside an open budget ledger',
    description:
      'A family expense tracker, with shared savings goals and Apple Pay imports through an iOS Shortcut.',
    disciplines: ['App design', 'Web app development', 'Wallet imports'],
    tone: 'smoke',
    stamp: ['TRACK', 'PLAN', 'SHARE'],
    href: '/work/finance-me',
    width: 1400,
    height: 1120,
  },
];

const practiceBeats = [
  {
    title: 'Start with the problem',
    copy: 'I work out what people need to do, then sketch the screens and how they fit together.',
  },
  {
    title: 'Design and build',
    copy: 'I work on the interface and the code together. Trying things in a working app often shows me what needs to change.',
  },
  {
    title: 'Get it ready to use',
    copy: 'Before launch, I test the whole process, including what happens when something goes wrong. I keep refining it once people start using it.',
  },
];
---

<BaseLayout page={pages.home}>
  <div class="site-shell">
    <StudioNav home />

    <main id="main-content">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy" data-motion-group>
          <h1 id="hero-title" class="hero-title">
            <span class="title-line">
              <span class="pop" style="--i: 0">I make</span>
              <span class="pop title-outline" style="--i: 1">digital</span>
            </span>
            <span class="title-line">
              <span class="pop title-outline" style="--i: 2">products</span>
              <span class="pop" style="--i: 3">sing.</span>
            </span>
          </h1>
          <p data-motion="copy">
            I’m Ivaylo, a product-minded full-stack developer who designs the
            experience, builds the system, and stays until the real thing works.
          </p>
          <div class="hero-actions" data-motion="action">
            <a class="button button-dark" href="/work/hlp-labs" data-squash>
              See HLP Labs <ArrowIcon />
            </a>
            <a class="button button-paper" href="#work" data-squash>
              Browse the reel
            </a>
          </div>
          <ul
            class="proof-seals fade-up"
            style="--i: 2"
            aria-label="Core strengths"
          >
            <li>
              <svg viewBox="0 0 32 32" aria-hidden="true">
                <path
                  d="M3 16c4-6.2 8.3-9.2 13-9.2S25 9.8 29 16c-4 6.2-8.3 9.2-13 9.2S7 22.2 3 16Z"
                ></path>
                <circle cx="16" cy="16" r="4.4"></circle>
                <circle class="ink" cx="17.4" cy="14.6" r="1.1"></circle>
              </svg>
              Product judgment
            </li>
            <li>
              <svg viewBox="0 0 32 32" aria-hidden="true">
                <rect x="7" y="4.5" width="18" height="7" rx="2"></rect>
                <rect x="10" y="12.5" width="18" height="7" rx="2"></rect>
                <rect x="5" y="20.5" width="18" height="7" rx="2"></rect>
              </svg>
              Full-stack depth
            </li>
            <li>
              <svg viewBox="0 0 32 32" aria-hidden="true">
                <rect x="4.5" y="9.5" width="23" height="18" rx="2.5"></rect>
                <path d="M4.5 15.5h23M16 9.5v6M11 5.5h10l2 4H9z"></path>
                <path d="m12 21.5 2.6 2.6 5.4-5.6"></path>
              </svg>
              Shipped craft
            </li>
          </ul>
        </div>

        <div class="hero-stage" data-loop>
          <div class="hero-cel cel-enter has-film">
            <img
              src="/assets/generated/hero-browser.webp"
              alt="A browser-window character sings into a vintage microphone on a small wooden stage"
              width="1536"
              height="1024"
              fetchpriority="high"
            />
            <FilmStatic />
          </div>
          <div class="stage-notes" aria-hidden="true">
            {
              Array.from({ length: 8 }, (_, index) => (
                <svg
                  class="stage-note"
                  viewBox={index % 4 === 1 ? '0 0 40 40' : '0 0 28 40'}
                  focusable="false"
                >
                  {index % 4 === 1 ? (
                    <>
                      <path d="M14 8v24M32 5v24" />
                      <ellipse
                        cx="9"
                        cy="32.5"
                        rx="5.6"
                        ry="4"
                        transform="rotate(-18 9 32.5)"
                      />
                      <ellipse
                        cx="27"
                        cy="29.5"
                        rx="5.6"
                        ry="4"
                        transform="rotate(-18 27 29.5)"
                      />
                      <path d="M14 8 32 5M14 14l18-3" />
                    </>
                  ) : (
                    <>
                      <path d="M15 5v26" />
                      <ellipse
                        cx="10"
                        cy="31.5"
                        rx="6"
                        ry="4.2"
                        transform="rotate(-18 10 31.5)"
                      />
                      {index % 4 !== 2 && <path d="M15 5c6 1.5 9 5 9.5 10.5" />}
                      {index % 4 === 3 && (
                        <path d="M15 12c5 1.5 7.5 4.5 8 8.5" />
                      )}
                    </>
                  )}
                </svg>
              ))
            }
          </div>
          <div class="stage-sign" aria-hidden="true">
            <span>Design</span>
            <i><span>+</span></i>
            <span>Code</span>
          </div>
        </div>

        <a class="scroll-cue fade-up" style="--i: 3" href="#work">
          <span>Roll the reel</span>
          <ArrowIcon direction="down" />
        </a>
      </section>

      <div class="wave-divider wave-hero" data-loop aria-hidden="true">
        <svg viewBox="0 0 2880 96" preserveAspectRatio="none">
          <path
            d="M0 51c80-42 160 42 240 0s160 42 240 0s160 42 240 0s160 42 240 0s160 42 240 0s160 42 240 0s160 42 240 0s160 42 240 0s160 42 240 0s160 42 240 0s160 42 240 0s160 42 240 0v80H0Z"
          ></path>
        </svg>
      </div>

      <section class="work-section" id="work" aria-labelledby="work-title">
        <div class="section-intro" data-motion-group>
          <h2 id="work-title" data-motion="title">
            <span class="title-line">A few things</span>
            <span class="title-line title-outline">I've built.</span>
          </h2>
          <p data-motion="copy">
            Open a project to see how it works and read about the choices I made
            while building it.
          </p>
        </div>

        <div class="project-reel" aria-label="Selected projects">
          {
            projects.map((project, index) => (
              <article
                class:list={['reel-project', `tone-${project.tone}`]}
                data-motion-group
              >
                <div class="reel-stage" data-motion="cel" data-loop>
                  <div class="reel-scene has-film">
                    <img
                      src={project.image}
                      alt={project.alt}
                      width={project.width}
                      height={project.height}
                      loading="lazy"
                    />
                    <FilmStatic />
                  </div>
                  <span class="reel-seal" aria-hidden="true">
                    <CircleWords
                      id={`seal-ring-${index}`}
                      words={project.stamp}
                      separator="·"
                      radius={43}
                      size={120}
                    >
                      <circle
                        class="seal-disc"
                        slot="back"
                        cx="60"
                        cy="60"
                        r="58"
                      />
                      <circle class="seal-dot" cx="60" cy="60" r="5" />
                    </CircleWords>
                  </span>
                </div>
                <div class="reel-copy">
                  <h3 data-motion="title">
                    <a
                      href={project.href}
                      data-transition-label={project.title}
                    >
                      {project.title}
                    </a>
                  </h3>
                  <p data-motion="copy">{project.description}</p>
                  <ul>
                    {project.disciplines.map((item) => (
                      <li data-motion="detail">{item}</li>
                    ))}
                  </ul>
                  <a
                    class="button button-light reel-case-link"
                    href={project.href}
                    data-transition-label={project.title}
                    data-motion="action"
                    data-squash
                  >
                    About {project.title} <ArrowIcon />
                  </a>
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <section
        class="practice-section"
        id="practice"
        aria-labelledby="practice-title"
      >
        <div class="practice-inner" data-motion-group>
          <h2 id="practice-title" data-motion="title">
            <span class="title-line">How I</span>
            <span class="title-line title-outline">work.</span>
          </h2>

          <figure class="practice-stage" data-motion="cel" data-loop>
            <div class="practice-frame has-film">
              <div class="film-strip film-strip-top" aria-hidden="true">
                <span class="film-sprockets"></span>
              </div>
              <img
                src={practiceConveyor.src}
                alt="One conveyor belt runs through three stations: a drafting table sketching a screen, a machine with a wrench tightening it, and a crate rolling into a delivery truck"
                width={practiceConveyor.width}
                height={practiceConveyor.height}
                loading="lazy"
              />
              <FilmStatic />
              <div class="film-strip film-strip-bottom" aria-hidden="true">
                <span class="film-sprockets"></span>
              </div>
            </div>
          </figure>

          <ol class="practice-track">
            {
              practiceBeats.map((beat) => (
                <li class="practice-beat" data-motion-group>
                  <h3 data-motion="title">{beat.title}</h3>
                  <p data-motion="copy">{beat.copy}</p>
                </li>
              ))
            }
          </ol>
        </div>
      </section>

      <section
        class="about-section"
        id="about"
        aria-labelledby="about-title"
        data-motion-group
      >
        <div
          class="about-portrait"
          data-motion="cel"
          data-motion-order="4"
          data-loop
        >
          <div class="portrait-disc has-film">
            <img
              src="/assets/generated/different-hats-browser.webp"
              alt="A browser-window character tips a designer's beret while holding a builder's hard hat"
              width="1024"
              height="1024"
              loading="lazy"
            />
            <FilmStatic />
          </div>
          <CircleWords
            id="name-curve"
            class="portrait-ring"
            words={['DESIGNER', 'DEVELOPER', 'MAKER']}
            repeats={2}
            radius={172}
            size={400}
          />
        </div>
        <div class="about-copy">
          <h2 id="about-title" data-motion="title">
            <span class="title-line">A little</span>
            <span class="title-line title-outline">about me.</span>
          </h2>
          <p class="about-lede" data-motion="copy" data-motion-order="1">
            I like being involved in both the design and the code. I might be
            sketching a checkout one day and working on the database the next.
          </p>
          <p data-motion="copy" data-motion-order="2">
            I'm based in Bulgaria and work as a full-stack developer at Vention.
            I also build independent projects, including the ones above. I enjoy
            working through tricky problems and making the result
            straightforward to use.
          </p>
        </div>
      </section>

      <section
        class="contact-section has-film"
        id="contact"
        aria-labelledby="contact-title"
        data-motion-group
        data-loop
      >
        <FilmStatic />
        <div class="contact-copy">
          <h2 id="contact-title" data-motion="title">
            <span class="title-line">Want to</span>
            <span class="title-line title-outline">work together?</span>
          </h2>
          <p data-motion="copy">
            If you have a project in mind or a role that could be a good fit,
            tell me a bit about it. I'd be happy to talk.
          </p>
          <a
            class="button button-dark"
            href="mailto:ivailoatanassov@gmail.com"
            data-motion="action"
            data-squash
          >
            ivailoatanassov@gmail.com <ArrowIcon />
          </a>
        </div>
        <div class="contact-stage" data-motion="slide" data-motion-side="right">
          <img
            class="contact-hand"
            src="/assets/generated/contact-hand.webp"
            alt="A white-gloved hand offers an open envelope with a blank card inside"
            width="1050"
            height="835"
            loading="lazy"
          />
        </div>
      </section>
    </main>

    <footer class="site-footer" data-motion-group>
      <a
        class="studio-mark studio-mark-inverse"
        href="#top"
        aria-label="Back to the top"
        data-motion="stamp"
        data-motion-order="0"
        data-squash
      >
        <svg viewBox="0 0 58 58" aria-hidden="true"
          ><path
            class="mark-disc"
            d="M29 3C44 3 55 14 55 29S44 55 29 55 3 44 3 29 14 3 29 3Z"
          ></path><path
            class="mark-eye"
            d="M18 21c3-4 7-2 7 3 0 4-2 7-5 7s-5-6-2-10Zm17-1c4-3 7 0 6 5 0 4-3 7-6 6-3-2-3-8 0-11Z"
          ></path><path class="mark-smile" d="M17 36c7 8 18 9 26-1"></path></svg
        >
        <span><strong>IVAYLO</strong><small>DOES IT ALL</small></span>
      </a>
      <p data-motion="copy" data-motion-order="1">
        Designed and built in Bulgaria.<br />Made with Astro and Tailwind.
      </p>
      <p class="footer-signoff" data-motion="copy" data-motion-order="2">
        That’s all, folks.
      </p>
    </footer>
  </div>
</BaseLayout>

<style>
  .reel-case-link {
    margin-top: 1.6rem;
  }
  .reel-copy h3 a {
    color: inherit;
    text-decoration: none;
  }
  .reel-copy h3 a:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.15em;
  }
</style>
